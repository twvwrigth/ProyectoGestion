@page
@model Proyecto.Pages.GestionDeClientesModel
@{
    ViewData["Title"] = "Catálogo de Clientes";
}

<div class="container-fluid py-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-transparent border-0 py-3 d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-1 fw-bold">Búsqueda y Registro de Clientes</h5>
                <p class="text-muted small mb-0">Gestión de expediente para ventas y exámenes</p>
            </div>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalCrearCliente">
                + Nuevo Cliente
            </button>
        </div>

        <div class="card-body">
            <!-- Buscador -->
            <form method="get" class="mb-4">
                <div class="input-group">
                    <input type="text" asp-for="TerminoBusqueda" class="form-control"
                           placeholder="Buscar por nombre o teléfono..." />
                    <button class="btn btn-outline-secondary" type="submit">🔍 Buscar</button>
                    @if (!string.IsNullOrEmpty(Model.TerminoBusqueda))
                    {
                        <a asp-page="./GestionDeClientes" class="btn btn-outline-danger">✖ Limpiar</a>
                    }
                </div>
            </form>

            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle w-100 mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="ps-3">Nombre del Cliente</th>
                            <th scope="col">Teléfono</th>
                            <th scope="col">Aviso de Privacidad</th>
                            <th scope="col" class="text-end pe-3" style="min-width: 180px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Clientes != null && Model.Clientes.Any())
                        {
                            @foreach (var cliente in Model.Clientes)
                            {
                                <tr>
                                    <td class="ps-3 fw-medium">@cliente.Nombre</td>
                                    <td>@(string.IsNullOrEmpty(cliente.Telefono) ? "Sin teléfono" : cliente.Telefono)</td>
                                    <td>
                                        @if (cliente.AvisoPrivacidad == true || cliente.AvisoPrivacidad?.ToString() == "1")
                                        {
                                            <span class="badge bg-success-subtle text-success">Firmado</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning">Pendiente</span>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        <div class="d-inline-flex gap-1 justify-content-end">
                                            <button type="button" class="btn btn-sm btn-outline-secondary btn-editar"
                                                    data-bs-toggle="modal" data-bs-target="#modalEditarCliente"
                                                    data-id="@cliente.IdCliente" data-nombre="@cliente.Nombre"
                                                    data-telefono="@cliente.Telefono"
                                                    data-privacidad="@(cliente.AvisoPrivacidad == true || cliente.AvisoPrivacidad?.ToString() == "1" ? "true" : "false")">
                                                Editar
                                            </button>
                                            <a asp-page="/Clientes/Detalle" asp-route-id="@cliente.IdCliente"
                                               class="btn btn-sm btn-primary">
                                                Ver Ficha
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    No se encontraron clientes.
                                    @(string.IsNullOrEmpty(Model.TerminoBusqueda) ? "Registra el primer cliente." : "Intenta con otro término de búsqueda.")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<partial name="~/Pages/Modales/_ModalesClientes.cshtml" />

@section Scripts {
    <script>
        // Llenar campos dinámicamente en el modal de Editar Cliente
        const modalEditarCliente = document.getElementById('modalEditarCliente');
        if (modalEditarCliente) {
            modalEditarCliente.addEventListener('show.bs.modal', function (event) {
                const btn = event.relatedTarget;
                modalEditarCliente.querySelector('#editIdCliente').value = btn.getAttribute('data-id');
                modalEditarCliente.querySelector('#editNombreCliente').value = btn.getAttribute('data-nombre');
                modalEditarCliente.querySelector('#editTelCliente').value = btn.getAttribute('data-telefono');
                
                // Marcar o desmarcar checkbox de privacidad
                const privacidad = btn.getAttribute('data-privacidad');
                modalEditarCliente.querySelector('#editAvisoPrivacidad').checked = (privacidad === "true");
            });
        }
    </script>
}