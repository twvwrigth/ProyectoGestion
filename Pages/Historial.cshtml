@page
@model Proyecto.Pages.Caja.HistorialModel
@{
    ViewData["Title"] = "Historial de Cortes";
}

<div class="container-fluid py-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-transparent border-0 py-3 d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-1 fw-bold">Historial de Cortes de Caja</h5>
                <p class="text-muted small mb-0">Revisión gerencial de turnos pasados</p>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive table-card">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="ps-3">Fecha de Cierre</th>
                            <th scope="col">Empleado</th>
                            <th scope="col">Fondo Inicial</th>
                            <th scope="col">Esperado</th>
                            <th scope="col">Contado</th>
                            <th scope="col">Diferencia</th>
                            <th scope="col">Comentario</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Cortes.Any())
                        {
                            @foreach (var corte in Model.Cortes)
                            {
                                <tr>
                                    <td class="ps-3 fw-medium">@corte.FechaCierre?.ToString("dd/MM/yyyy hh:mm tt")</td>
                                    <td>@corte.IdEmpleadoNavigation.Nombre</td>
                                    <td>$@corte.FondoInicial.ToString("0.00")</td>
                                    <td>$@corte.EfectivoEsperado?.ToString("0.00")</td>
                                    <td>$@corte.EfectivoContado?.ToString("0.00")</td>
                                    <td>
                                        @if(corte.Diferencia > 0) {
                                            <span class="text-success fw-bold">+$@corte.Diferencia?.ToString("0.00")</span>
                                        } else if(corte.Diferencia < 0) {
                                            <span class="text-danger fw-bold">-$@Math.Abs(corte.Diferencia ?? 0).ToString("0.00")</span>
                                        } else {
                                            <span class="text-muted">Cuadrada</span>
                                        }
                                    </td>
                                    <td class="small">@(string.IsNullOrEmpty(corte.ComentarioDiferencia) ? "-" : corte.ComentarioDiferencia)</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">No hay cortes registrados en el sistema.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>