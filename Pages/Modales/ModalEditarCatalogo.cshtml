<!-- Modal de Edición -->
<div class="modal fade" id="modalEditar" tabindex="-1" aria-labelledby="modalEditarLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title" id="modalEditarLabel">Editar Producto</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nombre / Modelo</label>
                        <input type="text" class="form-control" value="Ray-Ban Aviator Classic">
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Categoría</label>
                        <select class="form-select">
                            <option value="armazon">Armazón</option>
                            <option value="gafas_sol" selected>Gafas de sol</option>
                            <option value="accesorio">Accesorios</option>
                        </select>
                    </div>

                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label fw-bold">Precio</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control" value="2500.00">
                            </div>
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label fw-bold">Existencia</label>
                            <input type="number" class="form-control" value="15">
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary">Guardar Cambios</button>
            </div>
        </div>
    </div>
</div>