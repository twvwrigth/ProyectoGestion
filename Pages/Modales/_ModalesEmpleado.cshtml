@model Proyecto.Pages.GestionDeEmpleadosModel

<!-- Modal para Crear Empleado (Sin cambios) -->
<div class="modal fade" id="modalCrearEmpleado" tabindex="-1" aria-labelledby="modalCrearEmpleadoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="Crear">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="modalCrearEmpleadoLabel">Dar de Alta Empleado</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="nombreEmpleado" class="form-label">Nombre Completo</label>
                        <input type="text" id="nombreEmpleado" asp-for="Nombre" class="form-control" required placeholder="Ej. Juan Pérez" />
                        <span asp-validation-for="Nombre" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label for="usuarioEmpleado" class="form-label">Usuario Único</label>
                        <input type="text" id="usuarioEmpleado" asp-for="Usuario" class="form-control" required placeholder="Ej. jperez" />
                        <span asp-validation-for="Usuario" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label for="contrasenaTemporal" class="form-label">Contraseña</label>
                        <input type="text" id="contrasenaTemporal" asp-for="ContrasenaTemporal" class="form-control" />
                        <div class="form-text">En caso de no llenar este campo se asignará una temporal</div>
                    </div>

                    <div class="mb-3">
                        <label for="rolEmpleado" class="form-label">Asignar Rol</label>
                        <select id="rolEmpleado" asp-for="Rol" class="form-select">
                            <option value="1">Admin</option>
                            <option value="2">Encargado</option>
                            <option value="3">Cajero</option>
                            <option value="4">Almacenista</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar Empleado</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal para Editar Empleado (Funcional) -->
<div class="modal fade" id="modalEditarEmpleado" tabindex="-1" aria-labelledby="modalEditarEmpleadoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="Editar">
                <!-- ID Oculto necesario para el UPDATE -->
                <input type="hidden" id="editId" asp-for="EditId" />
                
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="modalEditarEmpleadoLabel">Editar Empleado</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="editNombre" class="form-label">Nombre Completo</label>
                        <input type="text" id="editNombre" asp-for="EditNombre" class="form-control" required />
                    </div>
                    
                    <div class="mb-3">
                        <label for="editUsuario" class="form-label">Usuario Único</label>
                        <input type="text" id="editUsuario" asp-for="EditUsuario" class="form-control" required />
                    </div>
                    
                    <div class="mb-3">
                        <label for="editRol" class="form-label">Rol Asignado</label>
                        <select id="editRol" asp-for="EditRol" class="form-select">
                            <option value="1">Admin</option>
                            <option value="2">Encargado</option>
                            <option value="3">Cajero</option>
                            <option value="4">Almacenista</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Actualizar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>