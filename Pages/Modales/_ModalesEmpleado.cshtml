@model Proyecto.Pages.GestionDeEmpleadosModel

<!-- Modal Reutilizable de Éxito -->
<div class="modal fade" id="modalExito" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow text-center p-3">
            <div class="modal-body">
                <div class="mb-3 text-success">
                    <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" fill="currentColor" class="bi bi-check-circle-fill" viewBox="0 0 16 16">
                        <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l5-5.25a.75.75 0 0 0-.019-1.06z"/>
                    </svg>
                </div>
                <h5 class="fw-bold mb-2">¡Éxito!</h5>
                <p class="text-muted small mb-0">@TempData["SuccessMessage"]</p>
            </div>
            <div class="modal-footer border-0 justify-content-center pt-0">
                <button type="button" class="btn btn-success px-4 rounded-pill" data-bs-dismiss="modal">Aceptar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Crear Empleado -->
<div class="modal fade" id="modalCrearEmpleado" tabindex="-1" aria-labelledby="modalCrearEmpleadoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="Crear">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Dar de Alta Empleado</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="nombreEmpleado" class="form-label">Nombre Completo</label>
                        <input type="text" id="nombreEmpleado" asp-for="Nombre" class="form-control" placeholder="Ej. Juan Pérez" />
                        <span asp-validation-for="Nombre" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label for="usuarioEmpleado" class="form-label">Usuario Único</label>
                        <input type="text" id="usuarioEmpleado" asp-for="Usuario" class="form-control" placeholder="Ej. jperez" />
                        <span asp-validation-for="Usuario" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label for="contrasenaTemporal" class="form-label">Contraseña Temporal</label>
                        <input type="text" id="contrasenaTemporal" asp-for="ContrasenaTemporal" class="form-control" placeholder="Opcional" />
                    </div>

                    <div class="mb-3">
                        <label for="rolEmpleado" class="form-label">Asignar Rol</label>
                        <select id="rolEmpleado" asp-for="Rol" class="form-select">
                            @if (Model.RolesList != null)
                            {
                                @foreach (var rol in Model.RolesList)
                                {
                                    <option value="@rol.IdRol">@rol.NombreRol</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar Empleado</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Editar Empleado -->
<div class="modal fade" id="modalEditarEmpleado" tabindex="-1" aria-labelledby="modalEditarEmpleadoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="Editar">
                <input type="hidden" id="editId" asp-for="EditId" />
                
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Editar Empleado</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="editNombre" class="form-label">Nombre Completo</label>
                        <input type="text" id="editNombre" asp-for="EditNombre" class="form-control" />
                        <span asp-validation-for="EditNombre" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label for="editUsuario" class="form-label">Usuario Único</label>
                        <input type="text" id="editUsuario" asp-for="EditUsuario" class="form-control" />
                        <span asp-validation-for="EditUsuario" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label for="editRol" class="form-label">Asignar Rol</label>
                        <select id="editRol" asp-for="EditRol" class="form-select">
                            @if (Model.RolesList != null)
                            {
                                @foreach (var rol in Model.RolesList)
                                {
                                    <option value="@rol.IdRol">@rol.NombreRol</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Actualizar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>