<!-- MODAL: Editar Producto -->
<div class="modal fade" id="modalEditar" tabindex="-1" aria-labelledby="modalEditarLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Editar">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title" id="modalEditarLabel">Editar Producto</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="editId" name="IdProductoEdit" />
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nombre / Modelo</label>
                        <input type="text" class="form-control" id="editNombre" name="NombreEdit" maxlength="50" required>
                    </div>

                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label fw-bold">Precio</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control" id="editPrecio" name="PrecioEdit" step="0.01" min="0.01" required>
                            </div>
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label fw-bold">Existencia</label>
                            <!-- HU-03: la existencia ya no se edita aquí (solo lectura).
                                 Para cambiar el stock usa «Ajustar inventario», con motivo y autorización. -->
                            <input type="number" class="form-control" id="editExistencia" name="ExistenciaEdit" min="0" required readonly>
                            <small class="text-muted">Solo lectura. El stock se ajusta con motivo en «Ajustar inventario».</small>
                        </div>
                    </div>

                    <!-- NUEVO: Contenedor para editar los detalles técnicos dinámicos -->
                    <div id="editCamposDinamicosContenedor" class="p-3 mb-3 bg-light border rounded" style="display: none;">
                        <h6 class="text-primary border-bottom pb-1">Detalles Técnicos</h6>
                        <div id="editInputsDinamicos"></div>
                        <input type="hidden" id="editDetallesTecnicosJson" name="DetallesTecnicosEdit" />
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: Dar de Baja Producto (HU-03: antes "Eliminar Producto", borrado físico.
     Ahora es baja lógica con motivo y autorización del Encargado; queda en Bitacora.) -->
<div class="modal fade" id="modalDarDeBaja" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <form method="post" asp-page-handler="DarDeBaja">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Dar de Baja Producto</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body text-center">
                    <input type="hidden" id="bajaId" name="IdProductoBaja" />

                    <p class="mb-2">¿Dar de baja este producto?</p>
                    <h6 id="nombreProductoBaja" class="fw-bold text-danger mb-3"></h6>
                    <p class="text-muted small mb-3">Ya no aparecerá en el catálogo ni en ventas. Las ventas viejas no se tocan. Esta acción queda en la bitácora.</p>

                    <div class="mb-3 text-start">
                        <label class="form-label fw-bold">Motivo de la baja</label>
                        <input type="text" class="form-control" name="MotivoBaja" placeholder="Ej. Roto, defectuoso, robado" maxlength="255" required />
                    </div>

                    <!-- Autorización del encargado (HU-03). Si quien da de baja ya es Encargado, se deja vacío.
                         Si trae un folio de autorización aprobada, se pone ahí y no hace falta usuario/clave. -->
                    @if (!User.IsInRole("Encargado") && !User.IsInRole("Admin"))
                    {
                    <div class="text-start p-2 bg-light border rounded">
                        <small class="fw-bold d-block mb-2">Autorización del encargado</small>
                        <input type="text" class="form-control form-control-sm mb-1" name="UsuarioEncargado" placeholder="Usuario del encargado" />
                        <input type="password" class="form-control form-control-sm mb-1" name="ClaveEncargado" placeholder="Clave del encargado" />
                        <input type="number" class="form-control form-control-sm" name="IdAutorizacion" placeholder="O folio de autorización aprobada" />
                    </div>
                    }
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">Sí, Dar de Baja</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: Ajuste Formal de Inventario (HU-03) -->
<div class="modal fade" id="modalAjusteInventario" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="AjustarInventario">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title">Ajuste de Inventario</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="ajusteId" name="IdProductoAjuste" />

                    <p class="mb-3">Producto: <strong id="nombreProductoAjuste"></strong> — Existencia actual: <strong id="existenciaActualAjuste"></strong></p>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Nueva cantidad</label>
                        <input type="number" class="form-control" name="CantidadDespues" min="0" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Tipo de ajuste</label>
                        <select class="form-select" name="TipoAjuste" required>
                            <option value="">Selecciona...</option>
                            <option value="Merma">Merma</option>
                            <option value="Dano">Pieza dañada</option>
                            <option value="Faltante">Faltante en conteo</option>
                            <option value="Conteo">Corrección por conteo</option>
                            <option value="Otro">Otro</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Motivo</label>
                        <input type="text" class="form-control" name="MotivoAjuste" placeholder="Ej. 2 armazones rotos en bodega" maxlength="255" required />
                    </div>

                    <!-- Autorización del encargado (HU-03). Si quien ajusta ya es Encargado, se deja vacío. -->
                    @if (!User.IsInRole("Encargado") && !User.IsInRole("Admin"))
                    {
                    <div class="p-2 bg-light border rounded">
                        <small class="fw-bold d-block mb-2">Autorización del encargado</small>
                        <input type="text" class="form-control form-control-sm mb-1" name="UsuarioEncargado" placeholder="Usuario del encargado" />
                        <input type="password" class="form-control form-control-sm mb-1" name="ClaveEncargado" placeholder="Clave del encargado" />
                        <input type="number" class="form-control form-control-sm" name="IdAutorizacion" placeholder="O folio de autorización aprobada" />
                    </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-warning">Guardar Ajuste</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: Creador de Categorías (Camino 1 - Mejorado con Tipos de Datos) -->
<div class="modal fade" id="modalNuevaCategoria" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="CrearCategoria" id="formCrearCategoria">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">Crear Nueva Categoría</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nombre de la Categoría</label>
                        <input type="text" class="form-control" name="NuevaCategoriaNombre" placeholder="Ej. Lentes de Contacto" required>
                    </div>
                    
                    <label class="form-label fw-bold">Atributos solicitados</label>
                    <p class="small text-muted mb-2">Define el nombre del campo y su tipo de validación.</p>
                    
                    <div class="input-group mb-2">
                        <input type="text" id="inputAtributoNombre" class="form-control" placeholder="Nombre (Ej. Curva Base)">
                        <select id="selectAtributoTipo" class="form-select" style="max-width: 130px;">
                            <option value="text">Texto</option>
                            <option value="number">Número</option>
                        </select>
                        <button class="btn btn-outline-success" type="button" id="btnAgregarAtributo">Añadir</button>
                    </div>

                    <!-- Contenedor visual de etiquetas -->
                    <div id="contenedorAtributos" class="d-flex flex-wrap gap-2 mb-2 mt-3"></div>
                    
                    <!-- Input oculto que guardará el JSON estructurado -->
                    <input type="hidden" name="AtributosJson" id="hiddenAtributosJson" value="[]">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success">Guardar Categoría</button>
                </div>
            </form>
        </div>
    </div>
</div>