<!-- Modal para Crear Laboratorio -->
<div class="modal fade" id="modalCrearLaboratorio" tabindex="-1" aria-labelledby="modalCrearLaboratorioLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="Crear">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="modalCrearLaboratorioLabel">Nuevo Laboratorio</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="nombreLab" class="form-label">Nombre del Laboratorio</label>
                        <input type="text" id="nombreLab" name="Nombre" class="form-control" required placeholder="Ej. Laboratorio Central" />
                    </div>
                    <div class="mb-3">
                        <label for="tipoLab" class="form-label">Tipo</label>
                        <select id="tipoLab" name="Tipo" class="form-select">
                            <option value="Interno">Interno</option>
                            <option value="Externo">Externo</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="telLab" class="form-label">Teléfono</label>
                        <input type="tel" id="telLab" name="Telefono" class="form-control" placeholder="Ej. 2281234567" />
                    </div>
                    <div class="mb-3">
                        <label for="tiempoLab" class="form-label">Tiempo Promedio de Entrega</label>
                        <input type="text" id="tiempoLab" name="TiempoEntrega" class="form-control" placeholder="Ej. 3 a 5 días hábiles" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar Laboratorio</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal para Editar Laboratorio -->
<div class="modal fade" id="modalEditarLaboratorio" tabindex="-1" aria-labelledby="modalEditarLaboratorioLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="Editar">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="modalEditarLaboratorioLabel">Editar Laboratorio</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="editNombreLab" class="form-label">Nombre del Laboratorio</label>
                        <input type="text" id="editNombreLab" name="Nombre" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label for="editTipoLab" class="form-label">Tipo</label>
                        <select id="editTipoLab" name="Tipo" class="form-select">
                            <option value="Interno">Interno</option>
                            <option value="Externo">Externo</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="editTelLab" class="form-label">Teléfono</label>
                        <input type="tel" id="editTelLab" name="Telefono" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label for="editTiempoLab" class="form-label">Tiempo Promedio de Entrega</label>
                        <input type="text" id="editTiempoLab" name="TiempoEntrega" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Actualizar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal para Gestionar Usuarios del Laboratorio -->
<div class="modal fade" id="modalGestionarUsuarios" tabindex="-1" aria-labelledby="modalGestionarUsuariosLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalGestionarUsuariosLabel">Usuarios Asignados</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Sección 1: Formulario para crear un usuario ligado al laboratorio -->
                <div class="card mb-4 bg-light border-0">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3">Registrar Nuevo Laboratorista</h6>
                        <form method="post" asp-page-handler="CrearUsuarioLaboratorio">
                            <input type="hidden" id="labIdForUser" name="LaboratorioId" />
                            <div class="row g-2">
                                <div class="col-md-4">
                                    <input type="text" name="NombreEmpleado" class="form-control form-control-sm" placeholder="Nombre completo" required />
                                </div>
                                <div class="col-md-4">
                                    <input type="text" name="Usuario" class="form-control form-control-sm" placeholder="Usuario único" required />
                                </div>
                                <div class="col-md-4">
                                    <input type="password" name="PasswordTemporal" class="form-control form-control-sm" placeholder="Contraseña temporal" required />
                                </div>
                            </div>
                            <div class="mt-3 text-end">
                                <button type="submit" class="btn btn-sm btn-primary">+ Crear y Asignar Usuario</button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Sección 2: Tabla de usuarios ligados actualmente -->
                <h6 class="fw-bold mb-2">Usuarios Activos en este Laboratorio</h6>
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Nombre</th>
                                <th>Usuario</th>
                                <th>Estado</th>
                                <th class="text-end">Acción</th>
                            </tr>
                        </thead>
                        <tbody id="listaUsuariosLab">
                            <!-- Ejemplo estático/simulado que se poblará por backend o JS -->
                            <tr>
                                <td>Carlos Ruiz</td>
                                <td>cruiz_lab</td>
                                <td><span class="badge bg-success-subtle text-success">Activo</span></td>
                                <td class="text-end">
                                    <form method="post" asp-page-handler="DesactivarUsuario" class="d-inline">
                                        <input type="hidden" name="UsuarioId" value="1" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Desactivar</button>
                                    </form>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>