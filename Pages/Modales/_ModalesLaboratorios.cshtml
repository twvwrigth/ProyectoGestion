<!-- Modal para Crear Laboratorio -->
<div class="modal fade" id="modalCrearLaboratorio" tabindex="-1" aria-labelledby="modalCrearLaboratorioLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="Crear">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="modalCrearLaboratorioLabel">Nuevo Laboratorio</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="nombreLab" class="form-label">Nombre del Laboratorio</label>
                        <input type="text" id="nombreLab" name="Nombre" class="form-control" required
                               placeholder="Ej. Laboratorio Central" />
                    </div>
                    <div class="mb-3">
                        <label for="tipoLab" class="form-label">Tipo</label>
                        <select id="tipoLab" name="TipoLaboratorio" class="form-select">
                            <option value="Interno">Interno</option>
                            <option value="Externo">Externo</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="telLab" class="form-label">Teléfono</label>
                        <input type="tel" id="telLab" name="Telefono" class="form-control"
                               placeholder="Ej. 2281234567" />
                    </div>
                    <div class="mb-3">
                        <label for="tiempoLab" class="form-label">Tiempo Promedio de Entrega</label>
                        <input type="text" id="tiempoLab" name="TiempoEntrega" class="form-control" maxlength="50"
                               placeholder="Ej. 3 a 5 días" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar Laboratorio</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal para Editar Laboratorio -->
<div class="modal fade" id="modalEditarLaboratorio" tabindex="-1" aria-labelledby="modalEditarLaboratorioLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="Editar">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editIdLab" name="IdLaboratorio" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="modalEditarLaboratorioLabel">Editar Laboratorio</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="editNombreLab" class="form-label">Nombre del Laboratorio</label>
                        <input type="text" id="editNombreLab" name="Nombre" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label for="editTipoLab" class="form-label">Tipo</label>
                        <select id="editTipoLab" name="TipoLaboratorio" class="form-select">
                            <option value="Interno">Interno</option>
                            <option value="Externo">Externo</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="editTelLab" class="form-label">Teléfono</label>
                        <input type="tel" id="editTelLab" name="Telefono" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label for="editTiempoLab" class="form-label">Tiempo Promedio de Entrega</label>
                        <input type="text" id="editTiempoLab" name="TiempoEntrega" class="form-control"
                               maxlength="50" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Actualizar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal para Gestionar Usuarios del Laboratorio -->
<div class="modal fade" id="modalGestionarUsuarios" tabindex="-1" aria-labelledby="modalGestionarUsuariosLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalGestionarUsuariosLabel">Usuarios Asignados</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="card mb-4 bg-light border-0">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3">Registrar Nuevo Laboratorista</h6>
                        <!-- Formulario dentro de #modalGestionarUsuarios -->
                        <form method="post" asp-page-handler="CrearUsuarioLaboratorio">
                            @Html.AntiForgeryToken()
                            <input type="hidden" id="labIdForUser" name="laboratorioId" />
                            <div class="row g-2">
                                <div class="col-md-4">
                                    <input type="text" name="nombreEmpleado" class="form-control form-control-sm"
                                           placeholder="Nombre completo" required />
                                </div>
                                <div class="col-md-4">
                                    <input type="email" id="emailLaboratorista" name="usuario"
                                           class="form-control form-control-sm" placeholder="correo@ejemplo.com"
                                           required />
                                </div>
                                <div class="col-md-4">
                                    <input type="text" id="passLaboratorista" name="passwordTemporal"class="form-control form-control-sm" placeholder="Contraseña asignada" />
                                    <div class="form-text">(Puedes cambiar la contraseña asignada si lo prefieres)</div>
                                </div>
                            </div>
                            <div class="mt-3 text-end">
                                <button type="submit" class="btn btn-sm btn-primary">+ Crear y Asignar Usuario</button>
                            </div>
                        </form>
                    </div>
                </div>

                <h6 class="fw-bold mb-2">Usuarios Activos en este Laboratorio</h6>
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Nombre</th>
                                <th>Correo Electronico</th>
                                <th>Estado</th>
                                <th class="text-end">Acción</th>
                            </tr>
                        </thead>
                        <tbody id="listaUsuariosLab">
                            <!-- Datos inyectados dinámicamente desde JS -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>