@page
@model Proyecto.Pages.TrabajoLaboratorioModel
@{
    ViewData["Title"] = "Producción de Laboratorio";
}

<div class="container-fluid py-4">
    <h4 class="fw-bold mb-3 text-secondary"><i class="bi bi-tools"></i> Trabajo del Laboratorista</h4>
    <p class="text-muted small">Visualizando únicamente órdenes asignadas a tu laboratorio (sin precios ni datos personales).</p>
    
    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger">@TempData["MensajeError"]</div>
    }
    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success">@TempData["MensajeExito"]</div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0 text-center">
                    <thead class="table-dark">
                        <tr>
                            <th>Folio</th>
                            <th>Fecha Promesa</th>
                            <th>Estado Actual</th>
                            <th class="text-start">Ficha Técnica (Receta)</th>
                            <th>Acciones de Producción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.PedidosLaboratorio != null && Model.PedidosLaboratorio.Any())
                        {
                            @foreach (var pedido in Model.PedidosLaboratorio)
                            {
                                <tr>
                                    <td class="fw-bold fs-5 text-primary">#@pedido.FolioPedido</td>
                                    <td>
                                        @if(pedido.FechaPromesa.HasValue) {
                                            <span class="@(pedido.FechaPromesa.Value < DateOnly.FromDateTime(DateTime.Now) ? "badge bg-danger" : "")">
                                                @pedido.FechaPromesa.Value.ToString("dd/MM/yyyy")
                                            </span>
                                        } else {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @(pedido.Estado == "En proceso" ? "bg-primary" : pedido.Estado == "Con incidencia" ? "bg-danger" : "bg-secondary") fs-6">
                                            @pedido.Estado
                                        </span>
                                    </td>
                                    <td class="text-start">
                                        @if(pedido.IdCotizacionNavigation?.IdRecetaNavigation != null)
                                        {
                                            var receta = pedido.IdCotizacionNavigation.IdRecetaNavigation;
                                            <div class="bg-light p-2 rounded border small">
                                                <div class="fw-bold text-success mb-1">Mica: @receta.TipoMica</div>
                                                <div><strong>OD:</strong> Esf @receta.EsferaOD | Cil @receta.CilindroOD | Eje @receta.EjeOD</div>
                                                <div><strong>OI:</strong> Esf @receta.EsferaOI | Cil @receta.CilindroOI | Eje @receta.EjeOI</div>
                                            </div>
                                        }
                                        else
                                        {
                                            <small class="text-muted">Sin receta adjunta</small>
                                        }
                                    </td>
                                    <td>
                                        <form method="post" asp-page-handler="CambiarEstado" class="d-inline m-0">
                                            <input type="hidden" name="folioPedido" value="@pedido.FolioPedido" />
                                            
                                            <!-- REGLA 2: No se pueden saltar estados -->
                                            @if (pedido.Estado == "Enviado a laboratorio" || pedido.Estado == "Con incidencia")
                                            {
                                                <input type="hidden" name="nuevoEstado" value="En proceso" />
                                                <button type="submit" class="btn btn-sm btn-primary px-3 shadow-sm">Iniciar Proceso</button>
                                            }
                                            else if (pedido.Estado == "En proceso")
                                            {
                                                <input type="hidden" name="nuevoEstado" value="Terminado" />
                                                <button type="submit" class="btn btn-sm btn-success px-4 mb-2 shadow-sm d-block mx-auto">Terminar</button>
                                                
                                                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#modalIncidencia_@pedido.FolioPedido">
                                                    <i class="bi bi-exclamation-triangle"></i> Reportar Incidencia
                                                </button>
                                            }
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" class="py-5 text-muted">No hay pedidos pendientes asignados a tu laboratorio.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- REGLA 3: Modales de Incidencia -->
@if (Model.PedidosLaboratorio != null)
{
    @foreach (var p in Model.PedidosLaboratorio.Where(x => x.Estado == "En proceso"))
    {
        <div class="modal fade" id="modalIncidencia_@p.FolioPedido" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form method="post" asp-page-handler="CambiarEstado">
                        <div class="modal-header bg-danger text-white">
                            <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill"></i> Reportar Problema (Folio #@p.FolioPedido)</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                        </div>
                        <div class="modal-body">
                            <input type="hidden" name="folioPedido" value="@p.FolioPedido" />
                            <input type="hidden" name="nuevoEstado" value="Con incidencia" />
                            
                            <div class="mb-3">
                                <label class="form-label fw-bold">Motivo de la incidencia:</label>
                                <select name="motivoIncidencia" class="form-select" required>
                                    <option value="" selected disabled>Seleccione el motivo...</option>
                                    <option value="Mica dañada">Mica dañada</option>
                                    <option value="Receta inconsistente">Receta inconsistente</option>
                                    <option value="Armazón no apto">Armazón no apto</option>
                                    <option value="Falta material">Falta material</option>
                                </select>
                                <div class="form-text text-danger mt-2">Ventas recibirá automáticamente este motivo en su tablero.</div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-danger">Confirmar Problema</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}