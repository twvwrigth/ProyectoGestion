@page 
@model Proyecto.Pages.Laboratorios.IndexModel
@{
    ViewData["Title"] = "Gestión de Laboratorios";
}

<div class="container-fluid py-4">
    <!-- Contenedor Principal estilo Card / Table-Card -->
    <div class="card shadow-sm border-0">
        <!-- Encabezado de la Tarjeta -->
        <div class="card-header bg-transparent border-0 py-3 d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-1 fw-bold">Gestión de Laboratorios</h5>
                <p class="text-muted small mb-0">Administración de laboratorios internos y externos</p>
            </div>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalCrearLaboratorio">
                + Nuevo Laboratorio
            </button>
        </div>

        <!-- Cuerpo de la Tarjeta con la Tabla Responsiva -->
        <div class="card-body p-0">
            <div class="table-responsive table-card">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="ps-3">Nombre</th>
                            <th scope="col">Tipo</th>
                            <th scope="col">Teléfono</th>
                            <th scope="col">Tiempo Prom. Entrega</th>
                            <th scope="col">Estado</th>
                            <th scope="col" class="text-end pe-3">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Laboratorios != null && Model.Laboratorios.Any())
                        {
                            @foreach (var lab in Model.Laboratorios)
                            {
                                <tr>
                                    <td class="ps-3 fw-medium">@lab.Nombre</td>
                                    <td>
                                        @if (lab.Tipo == "Interno")
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">@lab.Tipo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">@lab.Tipo</span>
                                        }
                                    </td>
                                    <td>@lab.Telefono</td>
                                    <td>@lab.TiempoEntrega</td>
                                    <td>
                                        @if (lab.Activo)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">Desactivado</span>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        <button type="button" class="btn btn-sm btn-outline-secondary me-1" data-bs-toggle="modal" data-bs-target="#modalEditarLaboratorio" data-id="@lab.Nombre">
                                            Editar
                                        </button>
                                        @if (lab.Activo)
                                        {
                                            <form method="post" asp-page-handler="Desactivar" asp-route-id="@lab.Nombre" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Desactivar</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form method="post" asp-page-handler="Activar" asp-route-id="@lab.Nombre" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-success">Activar</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">No hay laboratorios registrados.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Crear Laboratorio -->
<div class="modal fade" id="modalCrearLaboratorio" tabindex="-1" aria-labelledby="modalCrearLaboratorioLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="Crear">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="modalCrearLaboratorioLabel">Nuevo Laboratorio</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="nombreLab" class="form-label">Nombre del Laboratorio</label>
                        <input type="text" id="nombreLab" name="Nombre" class="form-control" required placeholder="Ej. Laboratorio Central" />
                    </div>
                    <div class="mb-3">
                        <label for="tipoLab" class="form-label">Tipo</label>
                        <select id="tipoLab" name="Tipo" class="form-select">
                            <option value="Interno">Interno</option>
                            <option value="Externo">Externo</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="telLab" class="form-label">Teléfono</label>
                        <input type="tel" id="telLab" name="Telefono" class="form-control" placeholder="Ej. 2281234567" />
                    </div>
                    <div class="mb-3">
                        <label for="tiempoLab" class="form-label">Tiempo Promedio de Entrega</label>
                        <input type="text" id="tiempoLab" name="TiempoEntrega" class="form-control" placeholder="Ej. 3 a 5 días hábiles" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar Laboratorio</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal para Editar Laboratorio -->
<div class="modal fade" id="modalEditarLaboratorio" tabindex="-1" aria-labelledby="modalEditarLaboratorioLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="Editar">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="modalEditarLaboratorioLabel">Editar Laboratorio</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="editNombreLab" class="form-label">Nombre del Laboratorio</label>
                        <input type="text" id="editNombreLab" name="Nombre" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label for="editTipoLab" class="form-label">Tipo</label>
                        <select id="editTipoLab" name="Tipo" class="form-select">
                            <option value="Interno">Interno</option>
                            <option value="Externo">Externo</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="editTelLab" class="form-label">Teléfono</label>
                        <input type="tel" id="editTelLab" name="Telefono" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label for="editTiempoLab" class="form-label">Tiempo Promedio de Entrega</label>
                        <input type="text" id="editTiempoLab" name="TiempoEntrega" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Actualizar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>