@page 
@model Proyecto.Pages.Laboratorios.IndexModel
@{
    ViewData["Title"] = "Gestión de Laboratorios";
}

<div class="container-fluid py-4">
    <!-- Contenedor Principal estilo Card / Table-Card -->
    <div class="card shadow-sm border-0">
        <!-- Encabezado de la Tarjeta -->
        <div class="card-header bg-transparent border-0 py-3 d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-1 fw-bold">Gestión de Laboratorios</h5>
                <p class="text-muted small mb-0">Administración de laboratorios internos y externos</p>
            </div>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalCrearLaboratorio">
                + Nuevo Laboratorio
            </button>
        </div>

        <!-- Cuerpo de la Tarjeta con la Tabla Responsiva -->
        <div class="card-body p-0">
            <div class="table-responsive table-card">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="ps-3">Nombre</th>
                            <th scope="col">Tipo</th>
                            <th scope="col">Teléfono</th>
                            <th scope="col">Tiempo Prom. Entrega</th>
                            <th scope="col">Estado</th>
                            <th scope="col" class="text-end pe-3">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Laboratorios != null && Model.Laboratorios.Any())
                        {
                            @foreach (var lab in Model.Laboratorios)
                            {
                                <tr>
                                    <td class="ps-3 fw-medium">@lab.Nombre</td>
                                    <td>
                                        @if (lab.Tipo == "Interno")
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">@lab.Tipo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">@lab.Tipo</span>
                                        }
                                    </td>
                                    <td>@lab.Telefono</td>
                                    <td>@lab.TiempoEntrega</td>
                                    <td>
                                        @if (lab.Activo)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">Desactivado</span>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        <button type="button" class="btn btn-sm btn-outline-secondary me-1" data-bs-toggle="modal" data-bs-target="#modalEditarLaboratorio" data-id="@lab.Nombre">
                                            Editar
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-primary me-1" data-bs-toggle="modal" data-bs-target="#modalGestionarUsuarios" data-lab-id="@lab.Nombre">
                                            Gestionar usuarios
                                        </button>
                                        @if (lab.Activo)
                                        {
                                            <form method="post" asp-page-handler="Desactivar" asp-route-id="@lab.Nombre" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Desactivar</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form method="post" asp-page-handler="Activar" asp-route-id="@lab.Nombre" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-success">Activar</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">No hay laboratorios registrados.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Llamada a la Vista Parcial única que contiene los tres modales -->
<partial name="~/Pages/Modales/_ModalesLaboratorios.cshtml" />