@page
@model Proyecto.Pages.Laboratorios.IndexModel
@{
    ViewData["Title"] = "Gestión de Laboratorios";
}

<div class="container-fluid py-4">
    @if (TempData["MensajeUsuarioCreado"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["MensajeUsuarioCreado"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorUsuario"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorUsuario"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <!-- Contenedor Principal estilo Card / Table-Card -->
    <div class="card shadow-sm border-0">
        <!-- Encabezado de la Tarjeta -->
        <div class="card-header bg-transparent border-0 py-3 d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-1 fw-bold">Gestión de Laboratorios</h5>
                <p class="text-muted small mb-0">Administración de laboratorios internos y externos</p>
            </div>
            <div>
                <button type="button" id="btnToggleDesactivados" class="btn btn-outline-secondary me-2">
                    Mostrar desactivados
                </button>
                <button type="button" class="btn btn-primary" data-bs-toggle="modal"
                        data-bs-target="#modalCrearLaboratorio">
                    + Nuevo Laboratorio
                </button>
            </div>
        </div>

        <!-- Cuerpo de la Tarjeta con la Tabla Responsiva -->
        <div class="card-body p-0">
            <div class="table-responsive table-card">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="ps-3">Nombre</th>
                            <th scope="col">Tipo</th>
                            <th scope="col">Teléfono</th>
                            <th scope="col">Tiempo Prom. Entrega</th>
                            <th scope="col">Laboratoristas</th>
                            <th scope="col">Estado</th>
                            <th scope="col" class="text-end pe-3">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Laboratorios != null && Model.Laboratorios.Any())
                        {
                            @foreach (var lab in Model.Laboratorios)
                            {
                                <tr class="@(!lab.Activo ? "fila-inactiva d-none" : "")">
                                    <td class="ps-3 fw-medium">@lab.Nombre</td>
                                    <td>
                                        @if (lab.TipoLaboratorio == "Interno")
                                        {
                                            <span
                                            class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">@lab.TipoLaboratorio</span>
                                        }
                                        else
                                        {
                                            <span
                                            class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">@lab.TipoLaboratorio</span>
                                        }
                                    </td>
                                    <td>@lab.Telefono</td>
                                    <td>@lab.TiempoEntrega</td>
                                    <!-- Columna de Laboratoristas -->
                                    <td>
                                        @if (lab.Empleados != null && lab.Empleados.Any(e => e.Activo))
                                        {
                                            <div class="d-flex flex-wrap gap-1">
                                                @foreach (var emp in lab.Empleados.Where(e => e.Activo))
                                                {
                                                    <span class="badge bg-light text-dark border" title="@emp.Usuario">
                                                        @emp.Nombre
                                                    </span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Sin asignar</span>
                                        }
                                    </td>
                                    <td>
                                        @if (lab.Activo)
                                        {
                                            <span
                                            class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Activo</span>
                                        }
                                        else
                                        {
                                            <span
                                            class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">Desactivado</span>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        <button type="button" class="btn btn-sm btn-outline-secondary me-1 btn-editar"
                                                data-bs-toggle="modal" data-bs-target="#modalEditarLaboratorio"
                                                data-id="@lab.IdLaboratorio" data-nombre="@lab.Nombre"
                                                data-tipo="@lab.TipoLaboratorio" data-telefono="@lab.Telefono"
                                                data-tiempo="@lab.TiempoEntrega">
                                            Editar
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-primary me-1" data-bs-toggle="modal"
                                                data-bs-target="#modalGestionarUsuarios" data-lab-id="@lab.IdLaboratorio">
                                            Gestionar usuarios
                                        </button>
                                        @if (lab.Activo)
                                        {
                                            <form method="post" asp-page-handler="Desactivar" asp-route-id="@lab.IdLaboratorio"
                                                  class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Desactivar</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form method="post" asp-page-handler="Activar" asp-route-id="@lab.IdLaboratorio"
                                                  class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-success">Activar</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">No hay laboratorios registrados.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Llamada a la Vista Parcial única que contiene los tres modales -->
<partial name="~/Pages/Modales/_ModalesLaboratorios.cshtml" />

@section Scripts {
    <script>
        // Llenar campos dinámicamente en el modal de Editar
        const modalEditar = document.getElementById('modalEditarLaboratorio');
        if (modalEditar) {
            modalEditar.addEventListener('show.bs.modal', function (event) {
                const btn = event.relatedTarget;
                modalEditar.querySelector('#editIdLab').value = btn.getAttribute('data-id');
                modalEditar.querySelector('#editNombreLab').value = btn.getAttribute('data-nombre');
                modalEditar.querySelector('#editTipoLab').value = btn.getAttribute('data-tipo');
                modalEditar.querySelector('#editTelLab').value = btn.getAttribute('data-telefono');
                modalEditar.querySelector('#editTiempoLab').value = btn.getAttribute('data-tiempo');
            });
        }

        // Cargar usuarios dinámicamente según el laboratorio seleccionado
        const modalUsuarios = document.getElementById('modalGestionarUsuarios');
        if (modalUsuarios) {
            modalUsuarios.addEventListener('show.bs.modal', function (event) {
                const btn = event.relatedTarget;
                const labId = btn.getAttribute('data-lab-id');
                modalUsuarios.querySelector('#labIdForUser').value = labId;

                const tbody = modalUsuarios.querySelector('#listaUsuariosLab');
                tbody.innerHTML = '';

                // Extraemos el Anti-Forgery Token presente en el formulario de la página
                const tokenInput = modalUsuarios.querySelector('input[name="__RequestVerificationToken"]');
                const tokenHtml = tokenInput ? tokenInput.outerHTML : '';

                // Extraer laboratorios y empleados serializados
                const laboratorios = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Laboratorios.Select(l => new
                    {
                        id = l.IdLaboratorio,
                                                            empleados = l.Empleados.Select(e => new { id = e.IdEmpleado, nombre = e.Nombre, usuario = e.Usuario, activo = e.Activo })
                                    })));

                const labEncontrado = laboratorios.find(l => l.id == labId);

                if (labEncontrado && labEncontrado.empleados && labEncontrado.empleados.length > 0) {
                    labEncontrado.empleados.forEach(emp => {
                        const tr = document.createElement('tr');
                        tr.innerHTML = `
                                                <td>${emp.nombre}</td>
                                                <td>${emp.usuario}</td>
                                                <td><span class="badge ${emp.activo ? 'bg-success-subtle text-success' : 'bg-secondary-subtle text-secondary'}">${emp.activo ? 'Activo' : 'Inactivo'}</span></td>
                                                <td class="text-end">
                                                    ${emp.activo ? `
                                                    <form method="post" action="?handler=DesactivarUsuario" class="d-inline">
                                                        ${tokenHtml}
                                                        <input type="hidden" name="usuarioId" value="${emp.id}" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">Desactivar</button>
                                                    </form>` : `
                                                    <form method="post" action="?handler=ActivarUsuario" class="d-inline">
                                                        ${tokenHtml}
                                                        <input type="hidden" name="usuarioId" value="${emp.id}" />
                                                        <button type="submit" class="btn btn-sm btn-outline-success">Activar</button>
                                                    </form>`}
                                                </td>
                                            `;
                        tbody.appendChild(tr);
                    });
                } else {
                    tbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted py-3">No hay usuarios asignados a este laboratorio.</td></tr>';
                }
            });
        }

        // Toggle para mostrar u ocultar laboratorios desactivados
        const btnToggle = document.getElementById('btnToggleDesactivados');
        if (btnToggle) {
            let mostrandoInactivos = false;
            btnToggle.addEventListener('click', function () {
                mostrandoInactivos = !mostrandoInactivos;
                const filasInactivas = document.querySelectorAll('.fila-inactiva');

                filasInactivas.forEach(fila => {
                    if (mostrandoInactivos) {
                        fila.classList.remove('d-none');
                    } else {
                        fila.classList.add('d-none');
                    }
                });

                this.textContent = mostrandoInactivos ? 'Ocultar desactivados' : 'Mostrar desactivados';
                this.classList.toggle('btn-outline-secondary', !mostrandoInactivos);
                this.classList.toggle('btn-secondary', mostrandoInactivos);
            });
        }
        // Autogenerar contraseña temporal al escribir el correo del laboratorista
        const inputEmail = document.getElementById('emailLaboratorista');
        const inputPass = document.getElementById('passLaboratorista');

        if (inputEmail && inputPass) {
            let editadoManualmente = false;

            // Detectar si el usuario escribió manualmente en el campo de contraseña
            inputPass.addEventListener('input', function () {
                editadoManualmente = this.value.trim() !== '';
            });

            // Actualizar el valor automáticamente según lo que escriba en el correo
            inputEmail.addEventListener('input', function () {
                if (!editadoManualmente) {
                    const correo = this.value.trim();
                    inputPass.value = correo ? 'contrasena' + correo : '';
                }
            });
        }
    </script>
}