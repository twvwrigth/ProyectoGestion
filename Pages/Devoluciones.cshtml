@page
@model Proyecto.Pages.DevolucionesModel
@{
    ViewData["Title"] = "Devoluciones / Reembolsos";
}

<div class="container-fluid mt-4">
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">@TempData["Mensaje"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold"><i class="bi bi-arrow-counterclockwise me-2"></i>Devoluciones / Reembolsos</h2>
        @if (Model.PuedeDevolver)
        {
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalNuevaDevolucion">
                <i class="bi bi-plus-circle me-1"></i>Nueva devolución
            </button>
        }
    </div>

    @if (!Model.PuedeDevolver)
    {
        @if (Model.CajaAbierta == null)
        {
            <div class="card shadow-sm border-0 text-center py-5">
                <div class="card-body">
                    <div class="mb-3">
                        <i class="bi bi-lock-fill text-warning" style="font-size: 3.5rem;"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">No hay ninguna caja abierta</h4>
                    <p class="text-muted mb-0">Para hacer una devolución, primero abre el turno de caja.</p>
                </div>
            </div>
        }
        else
        {
            <div class="card shadow-sm border-0 text-center py-5">
                <div class="card-body">
                    <div class="mb-3">
                        <i class="bi bi-lock-fill text-warning" style="font-size: 3.5rem;"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">Caja en uso</h4>
                    <p class="text-muted mb-0">Actualmente hay un turno abierto por el usuario <strong>@Model.CajaAbierta.IdEmpleadoNavigation?.Nombre</strong>.</p>
                    <p class="text-muted small mt-1">Solo el usuario responsable o el encargado puede hacer devoluciones.</p>
                </div>
            </div>
        }
    }
    else
    {
        <p class="text-muted">Una devolución regresa el dinero al cliente y el producto al inventario. La venta queda marcada como <strong>Devuelta</strong>. Exige autorización del encargado y queda en la bitácora.</p>

        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Fecha</th>
                            <th>Folio venta</th>
                            <th>Producto</th>
                            <th class="text-center">Cant.</th>
                            <th class="text-end">Monto devuelto</th>
                            <th>Motivo</th>
                            <th>Registró</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.Devoluciones)
                        {
                            <tr>
                                <td class="fw-bold">@d.IdDevolucion</td>
                                <td>@d.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>VTA-@d.FolioVenta</td>
                                <td>@(d.FolioVentaNavigation?.IdProductoNavigation?.Nombre ?? "-")</td>
                                <td class="text-center">@d.CantidadDevuelta</td>
                                <td class="text-end fw-semibold">$@d.Monto.ToString("0.00")</td>
                                <td>@d.Motivo</td>
                                <td>@(d.IdEmpleadoNavigation?.Nombre ?? "-")</td>
                            </tr>
                        }
                        @if (!Model.Devoluciones.Any())
                        {
                            <tr><td colspan="8" class="text-center text-muted py-4">No hay devoluciones registradas.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@if (Model.PuedeDevolver)
{
    <!-- Modal: nueva devolución -->
    <div class="modal fade" id="modalNuevaDevolucion" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <form method="post" asp-page-handler="CrearDevolucion">
                    <div class="modal-header bg-warning">
                        <h5 class="modal-title fw-bold">Nueva devolución / reembolso</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row g-2 mb-3">
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Folio de la venta *</label>
                                <input type="number" name="folioVenta" class="form-control" min="1" required placeholder="Ej. 12" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Cantidad a devolver *</label>
                                <input type="number" name="cantidadDevuelta" class="form-control" min="1" value="1" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Monto a devolver ($) *</label>
                                <input type="number" name="montoDevuelto" class="form-control" min="0.01" step="0.01" required placeholder="0.00" />
                                <small class="text-muted">Normalmente: precio unitario × cantidad devuelta.</small>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Motivo *</label>
                            <textarea name="motivo" class="form-control" rows="2" required placeholder="Ej. armazón defectuoso, lente equivocado..."></textarea>
                        </div>
                        @if (!User.IsInRole("Encargado") && !User.IsInRole("Admin"))
                        {
                        <p class="fw-bold small mb-2">Autorización del encargado *</p>
                        <div class="row g-2">
                            <div class="col-6"><input type="text" name="usuarioEncargado" class="form-control" placeholder="Usuario del encargado" /></div>
                            <div class="col-6"><input type="password" name="claveEncargado" class="form-control" placeholder="Clave del encargado" /></div>
                        </div>
                        <div class="mt-2"><input type="number" name="idAutorizacion" class="form-control" placeholder="O folio de autorización aprobada" /></div>
                        <small class="text-muted">Si ya tienes un folio aprobado, ponlo ahí y deja usuario/clave vacíos.</small>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                        <button type="submit" class="btn btn-warning fw-bold">Registrar devolución</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
