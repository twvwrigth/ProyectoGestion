@page
@model Proyecto.Pages.ListaEsperaModel
@{
    ViewData["Title"] = "Lista de Espera";
}

<div class="container mt-4">
    <h2 class="border-bottom pb-2 mb-4">Lista de Espera del Optometrista</h2>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <strong>¡Anotado!</strong> @TempData["MensajeExito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }
    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show shadow-sm" role="alert">
            <strong>Retirado.</strong> @TempData["MensajeError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="row">
        <!-- Panel de Registro -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Registrar Llegada</h5>
                </div>
                <div class="card-body">
                    <form method="post" asp-page-handler="Registrar">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Nombre del Cliente</label>
                            <input type="text" class="form-control" asp-for="NombreClienteNuevo"
                                   placeholder="Ej. Juan Pérez" maxlength="255" required>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Agregar a Fila</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Monitor de Turnos -->
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Turnos Activos</h5>
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover table-striped mb-0 text-center align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th class="text-start">Paciente</th>
                                <th>Hora</th>
                                <th>Espera</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Turnos != null && Model.Turnos.Any())
                            {
                                int contador = 1;
                                foreach (var turno in Model.Turnos)
                                {
                                    var tiempoEspera = (DateTime.Now - turno.HoraLlegada).TotalMinutes;
                                    // Dependiendo de cómo generó EF tu modelo, ajusta "IdClienteNavigation" si es necesario
                                    var nombreCliente = turno.IdClienteNavigation?.Nombre ?? "Desconocido";

                                    <tr>
                                        <td><span class="badge bg-secondary fs-6">@contador</span></td>
                                        <td class="text-start fw-bold">@nombreCliente</td>
                                        <td>@turno.HoraLlegada.ToString("hh:mm tt")</td>
                                        <td>
                                            @if (tiempoEspera > 20)
                                            {
                                                <span class="text-danger fw-bold">@Math.Round(tiempoEspera) min</span>
                                            }
                                            else
                                            {
                                                <span class="text-success">@Math.Round(tiempoEspera) min</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex gap-2 justify-content-center">
                                                <a href="/Examen?idCliente=@turno.IdCliente"
                                                   class="btn btn-sm btn-success">Llamar a Examen</a>
                                                
                                                <form method="post" asp-page-handler="NoAtendido" class="m-0">
                                                    <!-- Mandamos el idLista real para retirarlo -->
                                                    <input type="hidden" name="idLista" value="@turno.IdLista" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">Retirar</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                    contador++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="py-4 text-muted">No hay pacientes en la fila.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <!-- ... Aquí terminan tus paneles de arriba ... -->
    </div> <!-- Cierre del div class="row" superior -->

    <!-- NUEVA SECCIÓN: Tabla de Clientes Existentes -->
    <div class="row mt-5">
        <div class="col-12">
            <div class="card shadow-sm border-info">
                <div class="card-header bg-info text-dark d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold">Clientes Registrados (Historial)</h5>
                    <div class="card-header bg-info text-dark d-flex justify-content-between align-items-center">
    
                        <!-- NUEVA BARRA DE BÚSQUEDA -->
                        <form method="get" class="m-0">
                            <div class="input-group input-group-sm" style="width: 300px;">
                                <input type="text" class="form-control" asp-for="BuscarCliente"
                                       placeholder="Nombre o teléfono...">
                                <button type="submit" class="btn btn-light text-dark border">Buscar</button>
            
                                <!-- Botón para limpiar la búsqueda si hay texto escrito -->
                                @if (!string.IsNullOrEmpty(Model.BuscarCliente))
                                {
                                    <a href="/ListaEspera" class="btn btn-danger text-white">X</a>
                                }
                            </div>
                        </form>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div style="max-height: 300px; overflow-y: auto;">
                        <table class="table table-hover table-striped mb-0 align-middle">
                            <thead class="table-light" style="position: sticky; top: 0; z-index: 1;">
                                <tr>
                                    <th class="ps-3">ID</th>
                                    <th>Nombre del Cliente</th>
                                    <th>Teléfono</th>
                                    <th class="text-center">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.ClientesRegistrados != null && Model.ClientesRegistrados.Any())
                                {
                                    @foreach (var cliente in Model.ClientesRegistrados)
                                    {
                                        <tr>
                                            <td class="ps-3 text-muted">#@cliente.IdCliente.ToString("D4")</td>
                                            <td class="fw-bold">@cliente.Nombre</td>
                                            <td>@(string.IsNullOrEmpty(cliente.Telefono) ? "Sin registrar" : cliente.Telefono)</td>
                                            <td class="text-center">
                                                <!-- Formulario para mandar a la fila con 1 clic -->
                                                <form method="post" asp-page-handler="AgregarExistente" class="m-0">
                                                    <input type="hidden" name="idCliente" value="@cliente.IdCliente" />
                                                    <button type="submit" class="btn btn-sm btn-outline-primary">
                                                        + Agregar a Fila
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="py-4 text-center text-muted">No hay clientes registrados en
                                            la base de datos aún.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>