@page
@model Proyecto.Pages.TableroPedidosModel
@{
    ViewData["Title"] = "Tablero de Pedidos";
}

<div class="container-fluid py-4">
    <!-- Alertas de operaciones de la HU-16 -->
    @if (TempData["MensajePedido"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            ✅ @TempData["MensajePedido"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["MensajeIncidencia"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show shadow-sm mb-4" role="alert">
            ⚠️ @TempData["MensajeIncidencia"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h5 class="mb-1 fw-bold">Tablero de Pedidos</h5>
                <p class="text-muted small mb-0">HU-15: Seguimiento de órdenes</p>
            </div>
            
            <div class="d-flex gap-3 align-items-center flex-grow-1 justify-content-end" style="max-width: 60%;">
                
                <!-- Botones para alternar vista (Solo se muestran si no hay búsqueda activa) -->
                @if (string.IsNullOrEmpty(Model.Buscar))
                {
                    <div class="btn-group shadow-sm" role="group" aria-label="Alternar vista">
                        <button type="button" class="btn btn-outline-primary active" id="btnVistaKanban" title="Vista de Tablero">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-kanban" viewBox="0 0 16 16">
                                <path d="M13.5 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1h-11a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1zm-11-1a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2z"/>
                                <path d="M6.5 3a1 1 0 0 1 1-1h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1a1 1 0 0 1-1-1zm-4 0a1 1 0 0 1 1-1h1a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1h-1a1 1 0 0 1-1-1zm8 0a1 1 0 0 1 1-1h1a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1h-1a1 1 0 0 1-1-1z"/>
                            </svg>
                        </button>
                        <button type="button" class="btn btn-outline-primary" id="btnVistaTabla" title="Vista de Tabla">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-table" viewBox="0 0 16 16">
                                <path d="M0 2a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm15 2h-4v3h4zm0 4h-4v3h4zm0 4h-4v3h3a1 1 0 0 0 1-1zm-5 3v-3H6v3zm-5 0v-3H1v2a1 1 0 0 0 1 1zm-4-4h4V8H1zm0-4h4V4H1zm5-3v3h4V4zm4 4H6v3h4z"/>
                            </svg>
                        </button>
                    </div>
                }

                <!-- Buscador -->
                <form method="get" class="d-flex flex-grow-1">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="search" asp-for="Buscar" class="form-control" placeholder="Buscar por Folio o Teléfono..." />
                        <button type="submit" class="btn btn-primary px-4">Buscar</button>
                        @if (!string.IsNullOrEmpty(Model.Buscar))
                        {
                            <a asp-page="/TableroPedidos" class="btn btn-outline-secondary">Limpiar</a>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Buscar))
    {
        <!-- VISTA DE RESULTADOS DE BÚSQUEDA (Siempre en tabla) -->
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                @RenderTablaPedidos(Model.PedidosList, Model)
            </div>
        </div>
    }
    else
    {
        <!-- VISTA KANBAN -->
        <div id="contenedorKanban" class="d-flex gap-4 overflow-auto pb-3" style="min-height: 60vh;">
            @foreach (var estado in Model.EstadosDefinidos)
            {
                var pedidosEnEstado = Model.PedidosList.Where(p => p.Estado == estado).ToList();

                <div class="bg-light rounded p-3 d-flex flex-column shadow-sm" style="min-width: 320px; width: 320px;">
                    <h6 class="fw-bold text-uppercase text-secondary mb-3 pb-2 border-bottom">
                        @estado <span class="badge bg-secondary float-end">@pedidosEnEstado.Count</span>
                    </h6>
                    
                    <div class="d-flex flex-column gap-3 flex-grow-1 overflow-auto">
                        @foreach (var p in pedidosEnEstado)
                        {
                            <div class="card border-0 shadow-sm">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="fw-bold fs-6">#@p.FolioPedido</span>
                                        @if (Model.EsAtrasado(p.FechaPromesa))
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Atrasado</span>
                                        }
                                        else if (Model.VenceManana(p.FechaPromesa))
                                        {
                                            <span class="badge bg-warning-subtle text-dark border border-warning-subtle px-2 py-1">Mañana</span>
                                        }
                                    </div>
                                    <div class="fw-medium mb-1">@p.IdClienteNavigation?.Nombre</div>
                                    <div class="text-muted small mb-2"><i class="bi bi-building"></i> @p.IdLaboratorioNavigation?.Nombre</div>
                                    <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                        <div class="small fw-bold text-success">Saldo: $@p.SaldoPendiente.ToString("0.00")</div>
                                        <button class="btn btn-sm btn-link text-decoration-none p-0" data-bs-toggle="modal" data-bs-target="#modalHistorial_@p.FolioPedido">Historial</button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- VISTA TABLA (Oculta por defecto, se activa con JS) -->
        <div id="contenedorTabla" class="card shadow-sm border-0 d-none">
            <div class="card-body p-0">
                 @RenderTablaPedidos(Model.PedidosList, Model)
            </div>
        </div>
    }
</div>

<partial name="Modales/_ModalesTableroPedidos" model="Model" />

<!-- Función local para no repetir el HTML de la tabla 2 veces -->
@functions {
    private Microsoft.AspNetCore.Html.IHtmlContent RenderTablaPedidos(List<Proyecto.Models.Pedido> pedidos, Proyecto.Pages.TableroPedidosModel model)
    {
        return Html.Raw($@"
            <div class='table-responsive table-card'>
                <table class='table table-striped table-hover align-middle mb-0'>
                    <thead class='table-light'>
                        <tr>
                            <th class='ps-3'>Folio</th>
                            <th>Cliente / Teléfono</th>
                            <th>Laboratorio</th>
                            <th>Estado</th>
                            <th>Fecha Promesa</th>
                            <th>Saldo</th>
                            <th class='text-end pe-3'>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        {(pedidos.Any() ? string.Join("", pedidos.Select(p => $@"
                            <tr>
                                <td class='ps-3 fw-bold'>#{p.FolioPedido}</td>
                                <td>
                                    <div class='fw-medium'>{p.IdClienteNavigation?.Nombre}</div>
                                    <div class='text-muted small'>{p.Telefono}</div>
                                </td>
                                <td>{p.IdLaboratorioNavigation?.Nombre}</td>
                                <td><span class='badge bg-secondary'>{p.Estado}</span></td>
                                <td>
                                    {(model.EsAtrasado(p.FechaPromesa) 
                                        ? $"<span class='badge bg-danger'>{p.FechaPromesa?.ToString("dd/MM/yyyy")} (Atrasado)</span>" 
                                        : model.VenceManana(p.FechaPromesa)
                                            ? $"<span class='badge bg-warning text-dark'>{p.FechaPromesa?.ToString("dd/MM/yyyy")} (Mañana)</span>"
                                            : $"<span>{p.FechaPromesa?.ToString("dd/MM/yyyy")}</span>")}
                                </td>
                                <td class='fw-bold text-success'>${p.SaldoPendiente.ToString("0.00")}</td>
                                <td class='text-end pe-3'>
                                    <button class='btn btn-sm btn-outline-primary' data-bs-toggle='modal' data-bs-target='#modalHistorial_{p.FolioPedido}'>
                                        Historial
                                    </button>
                                </td>
                            </tr>
                        ")) : "<tr><td colspan='7' class='text-center py-4 text-muted'>No se encontraron pedidos.</td></tr>")}
                    </tbody>
                </table>
            </div>
        ");
    }
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const btnKanban = document.getElementById("btnVistaKanban");
            const btnTabla = document.getElementById("btnVistaTabla");
            const contKanban = document.getElementById("contenedorKanban");
            const contTabla = document.getElementById("contenedorTabla");

            if (btnKanban && btnTabla) {
                // Recuperar la última vista elegida (o 'kanban' por defecto)
                const vistaGuardada = localStorage.getItem("vistaPedidosOptica") || "kanban";

                const aplicarVista = (vista) => {
                    if (vista === "tabla") {
                        btnTabla.classList.add("active");
                        btnKanban.classList.remove("active");
                        contTabla.classList.remove("d-none");
                        contKanban.classList.add("d-none");
                        localStorage.setItem("vistaPedidosOptica", "tabla");
                    } else {
                        btnKanban.classList.add("active");
                        btnTabla.classList.remove("active");
                        contKanban.classList.remove("d-none");
                        contTabla.classList.add("d-none");
                        localStorage.setItem("vistaPedidosOptica", "kanban");
                    }
                };

                // Aplicar la vista guardada al cargar la página
                aplicarVista(vistaGuardada);

                // Eventos de los botones
                btnKanban.addEventListener("click", () => aplicarVista("kanban"));
                btnTabla.addEventListener("click", () => aplicarVista("tabla"));
            }
        });
    </script>
}