@page
@model PreciosReglasPromocionesModel
@{
    ViewData["Title"] = "Gestión de Precios, Parámetros y Promociones";
}

<div class="container-fluid py-4">
    <!-- Encabezado Principal de la Vista -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <h2 class="h5 mb-1 fw-bold">Gestión de Precios, Parámetros y Promociones</h2>
                <p class="text-muted small mb-0">HU-08: Configuración general de la óptica</p>
            </div>
            <span class="badge bg-info-subtle text-info border border-info-subtle px-3 py-2">Rol: Encargado</span>
        </div>
    </div>

    <!-- Contenedor Principal con Pestañas -->
    <div class="card shadow-sm border-0">
        <!-- Navegación por Pestañas (Bootstrap Tab API) -->
        <div class="card-header bg-transparent border-0 pt-3 px-3 pb-0">
            <ul class="nav nav-tabs card-header-tabs" id="huTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active fw-semibold" id="micas-tab" data-bs-toggle="tab" data-bs-target="#micas" type="button" role="tab" aria-controls="micas" aria-selected="true">
                        Precios de Micas
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-semibold text-secondary" id="parametros-tab" data-bs-toggle="tab" data-bs-target="#parametros" type="button" role="tab" aria-controls="parametros" aria-selected="false">
                        Parámetros del Negocio
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-semibold text-secondary" id="promociones-tab" data-bs-toggle="tab" data-bs-target="#promociones" type="button" role="tab" aria-controls="promociones" aria-selected="false">
                        Promociones
                    </button>
                </li>
            </ul>
        </div>

        <!-- Contenido de las Pestañas -->
        <div class="card-body p-4">
            <div class="tab-content" id="huTabsContent">

                <!-- Pestaña 1: Precios de Micas -->
                <div class="tab-pane fade show active" id="micas" role="tabpanel" aria-labelledby="micas-tab">
                    <h5 class="fw-bold mb-3">Matriz de Precios</h5>

                    <!-- Formulario para agregar micas -->
                    <form method="post" class="row g-3 mb-4 align-items-end">
                        <div class="col-md-3">
                            <label for="material" class="form-label">Material</label>
                            <select id="material" name="Material" class="form-select">
                                <option selected>Seleccionar...</option>
                                <option value="CR-39">CR-39</option>
                                <option value="Policarbonato">Policarbonato</option>
                                <option value="Poliuretano">Poliuretano</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label for="tratamiento" class="form-label">Tratamiento</label>
                            <select id="tratamiento" name="Tratamiento" class="form-select">
                                <option selected>Ninguno</option>
                                <option value="Antirreflejante">Antirreflejante</option>
                                <option value="Fotocromático">Fotocromático</option>
                                <option value="Filtro Luz Azul">Filtro Luz Azul</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label for="rangoGrad" class="form-label">Rango Grad.</label>
                            <input type="text" id="rangoGrad" name="RangoGraduacion" class="form-control" placeholder="Ej. ±2.00" />
                        </div>
                        <div class="col-md-2">
                            <label for="precioMica" class="form-label">Precio (MXN)</label>
                            <input type="number" id="precioMica" name="Precio" class="form-control" placeholder="0.00" step="0.01" />
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100">+ Agregar</button>
                        </div>
                    </form>

                    <!-- Tabla estilo table-card idéntica a Gestión de Empleados -->
                    <div class="table-responsive table-card">
                        <table class="table table-striped table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="ps-3">Material</th>
                                    <th scope="col">Tratamiento</th>
                                    <th scope="col">Rango de Graduación</th>
                                    <th scope="col">Precio Autorizado</th>
                                    <th scope="col" class="text-end pe-3">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="ps-3 fw-medium">CR-39</td>
                                    <td>Filtro Luz Azul</td>
                                    <td>±2.00 a ±4.00</td>
                                    <td class="fw-bold">$850.00</td>
                                    <td class="text-end pe-3">
                                        <button type="button" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Pestaña 2: Parámetros del Negocio -->
                <div class="tab-pane fade" id="parametros" role="tabpanel" aria-labelledby="parametros-tab">
                    <h5 class="fw-bold mb-3">Reglas de Operación y Cobros</h5>

                    <form method="post">
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <div class="card h-100 border bg-light-subtle">
                                    <div class="card-body">
                                        <label for="precioExamen" class="form-label fw-bold">Precio Base del Examen</label>
                                        <div class="input-group mb-2">
                                            <span class="input-group-text">$</span>
                                            <input type="number" id="precioExamen" name="PrecioExamen" class="form-control" value="250.00" step="0.01" />
                                            <span class="input-group-text">MXN</span>
                                        </div>
                                        <small class="text-muted">Costo si el cliente no realiza compra de lentes.</small>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="card h-100 border bg-light-subtle">
                                    <div class="card-body">
                                        <label for="vigenciaBonif" class="form-label fw-bold">Vigencia de Bonificación</label>
                                        <div class="input-group mb-2">
                                            <input type="number" id="vigenciaBonif" name="VigenciaBonificacion" class="form-control" value="30" />
                                            <span class="input-group-text">Días</span>
                                        </div>
                                        <small class="text-muted">Días válidos para abonar el costo del examen a la compra.</small>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="card h-100 border bg-light-subtle">
                                    <div class="card-body">
                                        <label for="anticipoMin" class="form-label fw-bold">Anticipo Mínimo Requerido</label>
                                        <div class="input-group mb-2">
                                            <input type="number" id="anticipoMin" name="AnticipoMinimo" class="form-control" value="50" />
                                            <span class="input-group-text">%</span>
                                        </div>
                                        <small class="text-muted">Porcentaje inicial requerido para laboratorio.</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="text-end">
                            <button type="submit" class="btn btn-primary px-4">Guardar Parámetros</button>
                        </div>
                    </form>
                </div>

                <!-- Pestaña 3: Promociones -->
                <div class="tab-pane fade" id="promociones" role="tabpanel" aria-labelledby="promociones-tab">
                    <h5 class="fw-bold mb-3">Crear Nueva Promoción</h5>

                    <form method="post" class="row g-3 mb-4">
                        <div class="col-md-3">
                            <label for="nombrePromo" class="form-label">Nombre de Promoción</label>
                            <input type="text" id="nombrePromo" name="NombrePromocion" class="form-control" placeholder="Ej. Buen Fin" />
                        </div>
                        <div class="col-md-2">
                            <label for="tipoPromo" class="form-label">Tipo</label>
                            <select id="tipoPromo" name="TipoPromocion" class="form-select">
                                <option value="Porcentaje">Porcentaje (%)</option>
                                <option value="MontoFijo">Monto Fijo ($)</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label for="valorPromo" class="form-label">Valor</label>
                            <input type="number" id="valorPromo" name="Valor" class="form-control" placeholder="15" />
                        </div>
                        <div class="col-md-3">
                            <label for="aplicaPromo" class="form-label">Aplica a</label>
                            <input type="text" id="aplicaPromo" name="AplicaA" class="form-control" placeholder="Ej. Armazones" />
                        </div>
                        <div class="col-md-2">
                            <label for="vigenciaPromo" class="form-label">Vigencia (Fin)</label>
                            <input type="date" id="vigenciaPromo" name="FechaFin" class="form-control" />
                        </div>
                        <div class="col-md-9 d-flex align-items-center">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="acumulable" name="EsAcumulable" value="true" />
                                <label class="form-check-label fw-medium" for="acumulable">
                                    ¿Acumulable con otros descuentos?
                                </label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-primary w-100">Registrar Promoción</button>
                        </div>
                    </form>

                    <h5 class="fw-bold mb-3">Promociones Activas</h5>
                    <div class="table-responsive table-card">
                        <table class="table table-striped table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="ps-3">Nombre</th>
                                    <th scope="col">Tipo</th>
                                    <th scope="col">Valor</th>
                                    <th scope="col">Vigencia</th>
                                    <th scope="col" class="text-end pe-3">Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="ps-3 fw-medium">Descuento Estudiantes</td>
                                    <td>Porcentaje</td>
                                    <td class="fw-bold">10%</td>
                                    <td>01/09/2026 - 30/11/2026</td>
                                    <td class="text-end pe-3">
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Activa</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>