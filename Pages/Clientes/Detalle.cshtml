@page
@model Proyecto.Pages.Clientes.DetalleModel
@{
    ViewData["Title"] = "Ficha del Cliente";
}

<div class="container-fluid py-4">

    <!-- Mensaje de aviso de duplicado -->
    @if (TempData["MensajeDuplicado"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show shadow-sm border-warning mb-4" role="alert">
            <div class="d-flex align-items-center">
                <span class="fs-4 me-2">⚠️</span>
                <div>
                    <strong>Cliente detectado:</strong> @TempData["MensajeDuplicado"]
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Alerta de éxito al guardar receta -->
    @if (TempData["MensajeRecetaCreada"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-success mb-4" role="alert">
            <div class="d-flex align-items-center">
                <span class="fs-5 me-2">✅</span>
                <div>@TempData["MensajeRecetaCreada"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Encabezado Ficha del Cliente -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <h4 class="fw-bold mb-1">@Model.Cliente.Nombre</h4>
                <p class="text-muted mb-0 me-3 d-inline">
                    <strong>Teléfono:</strong> @(string.IsNullOrEmpty(Model.Cliente.Telefono) ? "Sin registrar" :
                                                                                                    Model.Cliente.Telefono)
                </p>
                <span
                    class="badge @(Model.Cliente.AvisoPrivacidad == true || Model.Cliente.AvisoPrivacidad?.ToString() == "1" ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning")">
                    @(Model.Cliente.AvisoPrivacidad == true || Model.Cliente.AvisoPrivacidad?.ToString() == "1" ? "Aviso de Privacidad Aceptado" : "Aviso Pendiente")
                </span>
            </div>
            <a asp-page="/GestionDeClientes" class="btn btn-outline-secondary">← Volver al Listado</a>
        </div>
    </div>

    <!-- Pedidos en Curso Destacados (Criterio 4) -->
    @{
        var pedidosEnCurso = Model.Cliente.Pedidos.Where(p => p.Estado != "Entregado" && p.Estado != "Cancelado").ToList();
    }
    @if (pedidosEnCurso.Any())
    {
        <div class="alert alert-info border-info shadow-sm mb-4">
            <h6 class="fw-bold text-info-emphasis mb-2">Pedidos Activos / En Curso (@pedidosEnCurso.Count)</h6>
            <div class="table-responsive">
                <table class="table table-sm table-borderless align-middle mb-0">
                    <thead>
                        <tr class="text-muted small">
                            <th>Folio</th>
                            <th>Laboratorio</th>
                            <th>Fecha Entrega</th>
                            <th>Saldo Pendiente</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ped in pedidosEnCurso)
                        {
                            <tr>
                                <td class="fw-bold">#@ped.FolioPedido</td>
                                <td>@(ped.IdLaboratorioNavigation?.Nombre ?? "N/A")</td>
                                <td>@(ped.FechaPromesa?.ToString("dd/MM/yyyy") ?? "Pendiente")</td>
                                <td class="text-danger fw-bold">$@ped.SaldoPendiente</td>
                                <td><span class="badge bg-primary">@ped.Estado</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Historial en Pestañas / Tabs -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-transparent border-bottom-0 pt-3">
            <ul class="nav nav-tabs card-header-tabs" id="fichaTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active fw-semibold" id="recetas-tab" data-bs-toggle="tab"
                            data-bs-target="#recetas" type="button" role="tab">
                        Recetas / Exámenes (@Model.Cliente.Receta.Count)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-semibold" id="ventas-tab" data-bs-toggle="tab" data-bs-target="#ventas"
                            type="button" role="tab">
                        Historial de Ventas (@Model.Cliente.Venta.Count)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-semibold" id="pedidos-tab" data-bs-toggle="tab" data-bs-target="#pedidos"
                            type="button" role="tab">
                        Todos los Pedidos (@Model.Cliente.Pedidos.Count)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-semibold" id="reparaciones-tab" data-bs-toggle="tab"
                            data-bs-target="#reparaciones" type="button" role="tab">
                        Reparaciones (@Model.Cliente.Reparacions.Count)
                    </button>
                </li>
            </ul>
        </div>
        <div class="card-body">
            <div class="tab-content" id="fichaTabsContent">

                <!-- Tab 1: Recetas -->
                <!-- Tab 1: Recetas -->
                <div class="tab-pane fade show active" id="recetas" role="tabpanel">
                    @{
                        // Ordenamos las recetas de la más reciente a la más antigua
                        var recetasOrdenadas = Model.Cliente.Receta
                            .OrderByDescending(r => r.Fecha)
                            .ThenByDescending(r => r.IdReceta) // 👈 Esto rompe el empate ordenando por la más recién insertada
                            .ToList();
                    }
                    }

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-2">
                            <thead class="table-light">
                                <tr>
                                    <th>Fecha</th>
                                    <th>OD (Esf/Cil/Eje)</th>
                                    <th>OI (Esf/Cil/Eje)</th>
                                    <th>DP</th>
                                    <th>Tipo Mica</th>
                                    <th>Emisor</th>
                                    <th class="text-end pe-3">Acciones</th>
                                </tr>
                            </thead>
            
                            @if (recetasOrdenadas.Any())
                            {
                                var ultimaReceta = recetasOrdenadas.First();
                                var historial = recetasOrdenadas.Skip(1).ToList();

                                <!-- 1. Mostrar siempre la receta más reciente -->
                                <tbody>
                                    <tr>
                                        <td class="fw-bold text-primary">
                                            @ultimaReceta.Fecha.ToString("dd/MM/yyyy")
                                            <span class="badge bg-primary-subtle text-primary ms-1">Actual</span>
                                        </td>
                                        <td class="fw-medium">@ultimaReceta.EsferaOD / @ultimaReceta.CilindroOD /
                                            @ultimaReceta.EjeOD°</td>
                                            <td class="fw-medium">@ultimaReceta.EsferaOI / @ultimaReceta.CilindroOI /
                                                @ultimaReceta.EjeOI°</td>
                                                <td>@ultimaReceta.DistanciaPupilar</td>
                                                <td>@ultimaReceta.TipoMica</td>
                                                <td>@ultimaReceta.Emisor</td>
                                                <td class="text-end pe-3">
                                                    <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal"
                                                            data-bs-target="#modalEditarReceta" data-esferaod="@ultimaReceta.EsferaOD"
                                                            data-cilindrood="@ultimaReceta.CilindroOD" data-ejeod="@ultimaReceta.EjeOD"
                                                            data-esferaoi="@ultimaReceta.EsferaOI"
                                                            data-cilindroi="@ultimaReceta.CilindroOI" data-ejeoi="@ultimaReceta.EjeOI"
                                                            data-dp="@ultimaReceta.DistanciaPupilar"
                                                            data-tipomica="@ultimaReceta.TipoMica" data-emisor="@ultimaReceta.Emisor">
                                                        ✏️ Actualizar
                                                    </button>
                                                </td>
                                            </tr>
                                        </tbody>

                                        <!-- 2. Mostrar el resto en un contenedor colapsable (solo si hay más de 1 receta) -->
                                        @if (historial.Any())
                                        {
                                            <tbody id="historialRecetas" class="collapse">
                                                @foreach (var rec in historial)
                                                {
                                                    <tr class="table-light text-muted">
                                                        <td>@(rec.Fecha.ToString("dd/MM/yyyy"))</td>
                                                        <td>@rec.EsferaOD / @rec.CilindroOD / @rec.EjeOD°</td>
                                                        <td>@rec.EsferaOI / @rec.CilindroOI / @rec.EjeOI°</td>
                                                        <td>@rec.DistanciaPupilar</td>
                                                        <td>@rec.TipoMica</td>
                                                        <td>@rec.Emisor</td>
                                                        <td class="text-end pe-3">
                                                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                                                    data-bs-toggle="modal" data-bs-target="#modalEditarReceta"
                                                                    data-esferaod="@rec.EsferaOD" data-cilindrood="@rec.CilindroOD"
                                                                    data-ejeod="@rec.EjeOD" data-esferaoi="@rec.EsferaOI"
                                                                    data-cilindroi="@rec.CilindroOI" data-ejeoi="@rec.EjeOI"
                                                                    data-dp="@rec.DistanciaPupilar" data-tipomica="@rec.TipoMica"
                                                                    data-emisor="@rec.Emisor">
                                                                Usar como base
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        }
                                    }
            else
                                    {
                                        <tbody>
                                            <tr>
                                                <td colspan="7" class="text-center text-muted py-3">No hay recetas o exámenes
                                                    registrados.</td>
                                                </tr>
                                            </tbody>
                                        }
                                    </table>

                                    <!-- Botón para desplegar historial -->
                                    @if (recetasOrdenadas.Count > 1)
                                    {
                                        <div class="d-flex justify-content-center mt-2 mb-3">
                                            <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse"
                                                    data-bs-target="#historialRecetas" aria-expanded="false"
                                                    aria-controls="historialRecetas">
                                                🕰️ Ver anteriores (@(recetasOrdenadas.Count - 1))
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div> <!-- FIN Tab Recetas -->

                            <!-- Tab 2: Ventas -->
                            <div class="tab-pane fade" id="ventas" role="tabpanel">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Folio</th>
                                                <th>Fecha</th>
                                                <th>Forma de Pago</th>
                                                <th>Total</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.Cliente.Venta != null && Model.Cliente.Venta.Any())
                                            {
                                                @foreach (var vta in Model.Cliente.Venta)
                                                {
                                                    <tr>
                                                        <td>#@vta.FolioVenta</td>
                                                        <td>@vta.Fecha.ToString("dd/MM/yyyy")</td>
                                                        <td>@vta.FormaPago</td>
                                                        <td class="fw-bold">$@vta.Total</td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="4" class="text-center text-muted py-3">Sin historial de ventas de
                                                        mostrador.</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div> <!-- FIN Tab Ventas -->

                                <!-- Tab 3: Pedidos -->
                                <div class="tab-pane fade" id="pedidos" role="tabpanel">
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Folio</th>
                                                    <th>Estado</th>
                                                    <th>Anticipo</th>
                                                    <th>Saldo Pendiente</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model.Cliente.Pedidos != null && Model.Cliente.Pedidos.Any())
                                                {
                                                    @foreach (var ped in Model.Cliente.Pedidos)
                                                    {
                                                        <tr>
                                                            <td>#@ped.FolioPedido</td>
                                                            <td><span class="badge bg-secondary">@ped.Estado</span></td>
                                                            <td>$@ped.AnticipoTotal</td>
                                                            <td>$@ped.SaldoPendiente</td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="4" class="text-center text-muted py-3">Sin registro de pedidos.</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div> <!-- FIN Tab Pedidos -->

                                <!-- Tab 4: Reparaciones -->
                                <div class="tab-pane fade" id="reparaciones" role="tabpanel">
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Folio</th>
                                                    <th>Descripción</th>
                                                    <th>Estado Falla</th>
                                                    <th>Precio Estimado</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model.Cliente.Reparacions != null && Model.Cliente.Reparacions.Any())
                                                {
                                                    @foreach (var rep in Model.Cliente.Reparacions)
                                                    {
                                                        <tr>
                                                            <td>#@rep.FolioReparacion</td>
                                                            <td>@rep.Descripcion</td>
                                                            <td>@rep.EstadoFalla</td>
                                                            <td>$@rep.PrecioEstimado</td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="4" class="text-center text-muted py-3">Sin reparaciones registradas.
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div> <!-- FIN Tab Reparaciones -->

                            </div>
                        </div>
                    </div>
                </div>

                <!-- Modal Editar / Nueva Versión de Receta -->
                <div class="modal fade" id="modalEditarReceta" tabindex="-1" aria-labelledby="modalEditarRecetaLabel"
                     aria-hidden="true">
                    <div class="modal-dialog modal-lg modal-dialog-centered">
                        <div class="modal-content border-0 shadow">
                            <form method="post" asp-page-handler="ActualizarReceta">
                                <input type="hidden" name="IdCliente" value="@Model.Cliente.IdCliente" />

                                <div class="modal-header">
                                    <h5 class="modal-title fw-bold" id="modalEditarRecetaLabel">Modificar Graduación de Receta</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="alert alert-info small py-2 mb-3">
                                        ℹ️ <strong>Nota:</strong> Al guardar los cambios, la receta anterior se mantendrá registrada en
                                        el historial y se creará una versión actualizada con la fecha de hoy.
                                    </div>

                                    <h6 class="fw-bold text-primary mb-2">👁️ Ojo Derecho (OD)</h6>
                                    <div class="row g-2 mb-3">
                                        <div class="col-md-4">
                                            <label class="form-label small">Esfera OD</label>
                                            <input type="text" id="recEsferaOD" name="EsferaOD" class="form-control" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small">Cilindro OD</label>
                                            <input type="text" id="recCilindroOD" name="CilindroOD" class="form-control" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small">Eje OD</label>
                                            <input type="text" id="recEjeOD" name="EjeOD" class="form-control" />
                                        </div>
                                    </div>

                                    <h6 class="fw-bold text-primary mb-2">👁️ Ojo Izquierdo (OI)</h6>
                                    <div class="row g-2 mb-3">
                                        <div class="col-md-4">
                                            <label class="form-label small">Esfera OI</label>
                                            <input type="text" id="recEsferaOI" name="EsferaOI" class="form-control" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small">Cilindro OI</label>
                                            <input type="text" id="recCilindroOI" name="CilindroOI" class="form-control" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small">Eje OI</label>
                                            <input type="text" id="recEjeOI" name="EjeOI" class="form-control" />
                                        </div>
                                    </div>

                                    <h6 class="fw-bold text-secondary mb-2">⚙️ Detalles Generales</h6>
                                    <div class="row g-2 mb-3">
                                        <div class="col-md-4">
                                            <label class="form-label small">Distancia Pupilar (DP)</label>
                                            <input type="text" id="recDp" name="DistanciaPupilar" class="form-control" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small">Tipo de Mica</label>
                                            <input type="text" id="recTipoMica" name="TipoMica" class="form-control"
                                                   placeholder="Ej. Monofocal, Bifal, etc." />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small">Emisor / Optometrista</label>
                                            <input type="text" id="recEmisor" name="Emisor" class="form-control" required />
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                                    <button type="submit" class="btn btn-primary">Guardar Nueva Versión</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                @section Scripts {
                    <script>
                        const modalEditarReceta = document.getElementById('modalEditarReceta');
                        if (modalEditarReceta) {
                            modalEditarReceta.addEventListener('show.bs.modal', function (event) {
                                const btn = event.relatedTarget;
                                modalEditarReceta.querySelector('#recEsferaOD').value = btn.getAttribute('data-esferaod') || '';
                                modalEditarReceta.querySelector('#recCilindroOD').value = btn.getAttribute('data-cilindrood') || '';
                                modalEditarReceta.querySelector('#recEjeOD').value = btn.getAttribute('data-ejeod') || '';
                                modalEditarReceta.querySelector('#recEsferaOI').value = btn.getAttribute('data-esferaoi') || '';
                                modalEditarReceta.querySelector('#recCilindroOI').value = btn.getAttribute('data-cilindroi') || '';
                                modalEditarReceta.querySelector('#recEjeOI').value = btn.getAttribute('data-ejeoi') || '';
                                modalEditarReceta.querySelector('#recDp').value = btn.getAttribute('data-dp') || '';
                                modalEditarReceta.querySelector('#recTipoMica').value = btn.getAttribute('data-tipomica') || '';
                                modalEditarReceta.querySelector('#recEmisor').value = btn.getAttribute('data-emisor') || '';
                            });
                        }
                    </script>
                }