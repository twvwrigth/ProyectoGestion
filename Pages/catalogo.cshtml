@page
@model Proyecto.Pages.CatalogoModel
@{
    ViewData["Title"] = "Catálogo de Productos";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="border-bottom pb-2">Catálogo de Productos</h2>
            <p class="text-muted">Registro y control de armazones, gafas de sol y accesorios.</p>
        </div>
    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <strong>¡Éxito!</strong> @TempData["MensajeExito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <strong>¡Atención!</strong> @TempData["MensajeError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="row">
        <!-- Panel Izquierdo: Formulario de Registro -->
        <div class="col-lg-4 col-md-12 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">Nuevo Producto</h5>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Nombre / Descripción general</label>
                            <input type="text" class="form-control" asp-for="NombreNuevo"
                                   placeholder="Ej. Ray-Ban Aviator" maxlength="20" required>
                        </div>
    
                        <div class="mb-3">
                            <label class="form-label fw-bold">Categoría</label>
                            <!-- Le agregamos el id "selectCategoria" para usarlo en JavaScript -->
                            <select class="form-select" asp-for="CategoriaNueva" id="selectCategoria" required>
                                <option value="" selected disabled>Selecciona una opción...</option>
                                <option value="armazon">Armazón</option>
                                <option value="gafas_sol">Gafas de sol</option>
                                <option value="accesorio">Accesorios</option>
                            </select>
                        </div>

                        <!-- SECCIÓN DINÁMICA: Solo visible si se elige Armazón -->
                        <div id="camposArmazon" style="display: none;" class="p-3 mb-3 bg-light border rounded">
                            <h6 class="text-primary border-bottom pb-1">Detalles del Armazón</h6>
                            <div class="mb-2">
                                <label class="form-label fw-bold small">Código Único (Numérico)</label>
                                <input type="number" class="form-control form-control-sm armazon-input"
                                       asp-for="CodigoArmazonNuevo">
                            </div>
                            <div class="row">
                                <div class="col-6 mb-2">
                                    <label class="form-label fw-bold small">Marca</label>
                                    <input type="text" class="form-control form-control-sm armazon-input"
                                           asp-for="MarcaNueva" maxlength="20">
                                </div>
                                <div class="col-6 mb-2">
                                    <label class="form-label fw-bold small">Modelo</label>
                                    <input type="text" class="form-control form-control-sm armazon-input"
                                           asp-for="ModeloNuevo" maxlength="15">
                                </div>
                            </div>
                            <div class="mb-2">
                                <label class="form-label fw-bold small">Material</label>
                                <input type="text" class="form-control form-control-sm armazon-input"
                                       asp-for="MaterialNuevo" maxlength="100">
                            </div>
                            <div class="form-check mt-2">
                                <input class="form-check-input" type="checkbox" asp-for="VentaSinGraduacionNueva"
                                       checked>
                                <label class="form-check-label small">Permitir venta sin graduar</label>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-6 mb-3">
                                <label class="form-label fw-bold">Precio</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input type="number" class="form-control" asp-for="PrecioNuevo" placeholder="0.00"
                                           step="0.01" min="0.01" required>
                                </div>
                            </div>
                            <div class="col-6 mb-3">
                                <label class="form-label fw-bold">Existencia</label>
                                <input type="number" class="form-control" asp-for="ExistenciaNueva" placeholder="0"
                                       min="0" required>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Guardar Producto</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Panel Derecho: Vista del Inventario Dinámico -->
        <div class="col-lg-8 col-md-12">
            <div class="card shadow-sm">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">Inventario Actual</h5>
                    <!-- Contenedor de Búsqueda y Filtro -->
                    <!-- Contenedor de Búsqueda y Filtro -->
                    <form method="get" class="d-flex gap-2 w-50 m-0">
                        <select class="form-select form-select-sm" asp-for="FiltroCategoria"
                                onchange="this.form.submit()">
                            <option value="todas">Todas las categorías</option>
                            <option value="armazon">Armazón</option>
                            <option value="gafas_sol">Gafas de sol</option>
                            <option value="accesorio">Accesorios</option>
                        </select>
    
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control" asp-for="Buscar" placeholder="Buscar producto...">
                            <button type="submit" class="btn btn-secondary">Buscar</button>
                        </div>
                    </form>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0 text-center align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>Código</th>
                                    <th class="text-start">Nombre</th>
                                    <th>Categoría</th>
                                    <th>Precio</th>
                                    <th>Stock</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Productos != null && Model.Productos.Any())
                                {
                                    @foreach (var producto in Model.Productos)
                                    {
                                        <tr>
                                            <td>PRD-@producto.IdProducto.ToString("D3")</td>
                                            <td class="text-start">@producto.Nombre</td>
                                            
                                            <!-- Verificación de categoría mediante tablas relacionadas -->
                                            <td>
                                                @if (producto.Armazones != null && producto.Armazones.Any())
                                                {
                                                    <span class="badge bg-secondary">Armazón</span>
                                                }
                                                else if (producto.GafasSolList != null && producto.GafasSolList.Any())
                                                {
                                                    <span class="badge bg-info text-dark">Gafas de sol</span>
                                                }
                                                else if (producto.Accesorios != null && producto.Accesorios.Any())
                                                {
                                                    <span class="badge bg-warning text-dark">Accesorio</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-dark">General</span>
                                                }
                                            </td>
                                            
                                            <td>$@producto.Precio.ToString("0.00")</td>
                                            
                                            <td>
                                                @if (producto.Existencia < 10)
                                                {
                                                    <span class="badge bg-danger">@producto.Existencia</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">@producto.Existencia</span>
                                                }
                                            </td>
                                            
                                            <td>
                                                <div class="btn-group">
                                                    <button type="button" class="btn btn-sm btn-outline-secondary"
                                                            data-bs-toggle="modal" data-bs-target="#modalEditar"
                                                            data-id="@producto.IdProducto" data-nombre="@producto.Nombre"
                                                            data-precio="@producto.Precio" data-existencia="@producto.Existencia">
                                                        Editar
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                                            data-bs-toggle="modal" data-bs-target="#modalEliminar"
                                                            data-id="@producto.IdProducto" data-nombre="@producto.Nombre">
                                                        Eliminar
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">No hay productos registrados en
                                            la base de datos.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    
        <!-- Inyectamos tu modal -->
        <partial name="~/Pages/Modales/ModalEditarCatalogo.cshtml" />


        @section Scripts {
            <script>
                    var modalEditar = document.getElementById('modalEditar')
                    modalEditar.addEventListener('show.bs.modal', function (event) {
                        // Botón que activó el modal
                        var button = event.relatedTarget
            
                        // Extraer la información de los atributos data-
                        var id = button.getAttribute('data-id')
                        var nombre = button.getAttribute('data-nombre')
                        var precio = button.getAttribute('data-precio')
                        var existencia = button.getAttribute('data-existencia')
            
                        // Inyectar los datos en los inputs del formulario del modal
                        modalEditar.querySelector('#editId').value = id;
                        modalEditar.querySelector('#editNombre').value = nombre;
                        modalEditar.querySelector('#editPrecio').value = parseFloat(precio).toFixed(2);
                        modalEditar.querySelector('#editExistencia').value = existencia;
                    })
                    
                    var modalEliminar = document.getElementById('modalEliminar');
                    modalEliminar.addEventListener('show.bs.modal', function (event) {
                        var button = event.relatedTarget;
        
                        var id = button.getAttribute('data-id');
                        var nombre = button.getAttribute('data-nombre');
        
                        modalEliminar.querySelector('#eliminarId').value = id;
                        modalEliminar.querySelector('#nombreProductoEliminar').textContent = nombre;
                    });
            </script>

            <script>
                    document.addEventListener("DOMContentLoaded", function () {
                        var selectCategoria = document.getElementById('selectCategoria');
                        var camposArmazon = document.getElementById('camposArmazon');
                        var inputsArmazon = document.querySelectorAll('.armazon-input');

                        selectCategoria.addEventListener('change', function () {
                            if (this.value === 'armazon') {
                                camposArmazon.style.display = 'block';
                                // Hacer obligatorios los campos del armazón
                                inputsArmazon.forEach(input => input.setAttribute('required', 'required'));
                            } else {
                                camposArmazon.style.display = 'none';
                                // Quitar la obligatoriedad si es gafa o accesorio
                                inputsArmazon.forEach(input => input.removeAttribute('required'));
                            }
                        });
                    });
            </script>
        }
    </div>