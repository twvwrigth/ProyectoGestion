@page
@model Proyecto.Pages.IndexModel
@{
    ViewData["Title"] = "Panel de Caja";
}

<div class="container-fluid py-4">
    <!-- Alertas de Éxito y Error -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-transparent border-0 py-3 d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h5 class="mb-1 fw-bold">Panel de Control de Caja</h5>
                <p class="text-muted small mb-0">HU-19: Gestión de turnos y flujos de efectivo</p>
            </div>
            
            @if (Model.CajaAbierta != null)
            {
                <div class="text-end">
                    @if (Model.CajaAbierta.IdEmpleado == Model.CurrentUserId)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill shadow-sm" style="font-size: 0.95rem;">
                            <i class="bi bi-person-check-fill me-1"></i> Tu turno está activo
                        </span>
                    }
                    else if (Model.EsAdminOEncargado)
                    {
                        <span class="badge bg-info-subtle text-info border border-info-subtle px-3 py-2 rounded-pill shadow-sm" style="font-size: 0.95rem;">
                            <i class="bi bi-shield-lock-fill me-1"></i> Supervisando caja de: <strong>@Model.CajaAbierta.IdEmpleadoNavigation?.Nombre</strong>
                        </span>
                    }
                </div>
            }
        </div>
    </div>

    @if (Model.CajaAbierta == null)
    {
        <div class="card shadow-sm border-0 text-center py-5">
            <div class="card-body">
                <h4 class="fw-bold text-dark mb-3">No hay ninguna caja abierta en el sistema</h4>
                <p class="text-muted mb-4">Para comenzar a registrar ventas o movimientos, abre el turno ingresando un fondo inicial.</p>
                <button type="button" class="btn btn-primary btn-lg px-5 rounded-pill shadow-sm" data-bs-toggle="modal" data-bs-target="#modalAbrirCaja">
                    Abrir Caja
                </button>
            </div>
        </div>
    }
    else if (Model.CajaAbierta.IdEmpleado != Model.CurrentUserId && !Model.EsAdminOEncargado)
    {
        <!-- ESCENARIO DE BLOQUEO (SOLO PARA CAJEROS QUE NO SEAN DUEÑOS) -->
        <div class="card shadow-sm border-0 text-center py-5">
            <div class="card-body">
                <div class="mb-3">
                    <i class="bi bi-lock-fill text-warning" style="font-size: 3.5rem;"></i>
                </div>
                <h4 class="fw-bold text-dark mb-2">Caja en uso</h4>
                <p class="text-muted mb-0">Actualmente hay un turno abierto por el usuario <strong>@Model.CajaAbierta.IdEmpleadoNavigation?.Nombre</strong>.</p>
                <p class="text-muted small mt-1">Solo el usuario responsable o un administrador pueden ver los saldos o hacer el corte del turno.</p>
            </div>
        </div>
    }
    else
    {
        <!-- DASHBOARD (VISIBLE PARA EL DUEÑO DE LA CAJA O EL ADMIN) -->
        @* SCRUM-12 HU-19: aviso de pedido con adeudo que llega desde el tablero (folioPedido). *@
        @if (Model.PedidoALiquidar != null)
        {
            <div class="alert alert-warning shadow-sm mb-4" role="alert">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div>
                        <h6 class="fw-bold mb-1"><i class="bi bi-exclamation-triangle-fill me-2"></i>Pedido #@Model.PedidoALiquidar.FolioPedido con saldo pendiente</h6>
                        <p class="mb-0">Cliente: <strong>@Model.PedidoALiquidar.IdClienteNavigation?.Nombre</strong> — Monto a liquidar: <strong>$@Model.PedidoALiquidar.SaldoPendiente.ToString("0.00")</strong></p>
                    </div>
                    @if (Model.PedidoALiquidar.Estado == "Listo para entrega")
                    {
                        <form method="post" asp-page-handler="LiquidarPedido" class="d-flex align-items-center gap-2">
                            <input type="hidden" name="folioPedido" value="@Model.PedidoALiquidar.FolioPedido" />
                            <select name="formaPago" class="form-select form-select-sm" style="width: auto;" required>
                                <option value="Efectivo" selected>Efectivo</option>
                                <option value="Tarjeta">Tarjeta</option>
                                <option value="Transferencia">Transferencia</option>
                            </select>
                            <button type="submit" class="btn btn-warning btn-sm fw-bold">Liquidar saldo</button>
                        </form>
                    }
                    else
                    {
                        <span class="text-muted small">🔒 No se puede liquidar todavía: el pedido está en "@Model.PedidoALiquidar.Estado". Se liquida cuando esté "Listo para entrega".</span>
                    }
                </div>
            </div>
        }

        <div class="row g-4 mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm bg-primary text-white h-100">
                    <div class="card-body">
                        <h6 class="text-white-50 text-uppercase fw-bold">Saldo Actual en Caja</h6>
                        <h2 class="fw-bold mb-0">$@Model.SaldoActual.ToString("0.00")</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <h6 class="text-muted text-uppercase fw-bold">Fondo Inicial</h6>
                        <h3 class="text-dark fw-bold mb-0">$@Model.CajaAbierta.FondoInicial.ToString("0.00")</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <h6 class="text-muted text-uppercase fw-bold">Entradas Manuales</h6>
                        <h3 class="text-success fw-bold mb-0">+$@Model.TotalEntradas.ToString("0.00")</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <h6 class="text-muted text-uppercase fw-bold">Salidas Manuales</h6>
                        <h3 class="text-danger fw-bold mb-0">-$@Model.TotalSalidas.ToString("0.00")</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-transparent border-bottom py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h6 class="mb-0 fw-bold">Movimientos Extra del Turno</h6>
                <div>
                    <button type="button" class="btn btn-outline-primary btn-sm me-2" data-bs-toggle="modal" data-bs-target="#modalMovimiento">
                        + Registrar Movimiento
                    </button>
                    <a asp-page="/Corte" class="btn btn-danger btn-sm">Hacer Corte de Caja</a>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive table-card">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="ps-3">Hora</th>
                                <th scope="col">Tipo</th>
                                <th scope="col">Motivo</th>
                                <th scope="col" class="text-end pe-3">Monto</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if(Model.CajaAbierta.MovimientoCajas != null && Model.CajaAbierta.MovimientoCajas.Any())
                            {
                                @foreach (var mov in Model.CajaAbierta.MovimientoCajas.OrderByDescending(m => m.Fecha))
                                {
                                    <tr>
                                        <td class="ps-3">@mov.Fecha.ToString("hh:mm tt")</td>
                                        <td>
                                            @if(mov.Tipo == "Entrada") {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Entrada</span>
                                            } else {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Salida</span>
                                            }
                                        </td>
                                        <td>@mov.Motivo</td>
                                        <td class="text-end pe-3 fw-bold @(mov.Tipo == "Entrada" ? "text-success" : "text-danger")">
                                            @(mov.Tipo == "Entrada" ? "+" : "-") $@mov.Monto.ToString("0.00")
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">No hay movimientos extra registrados en este turno.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @* SCRUM-12 HU-19: historial de ventas del turno (antes solo se listaban los movimientos extra). *@
        <div class="card shadow-sm border-0">
            <div class="card-header bg-transparent border-bottom py-3">
                <h6 class="mb-0 fw-bold">Historial de ventas del turno</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive table-card">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="ps-3">Folio</th>
                                <th scope="col">Cliente</th>
                                <th scope="col">Producto</th>
                                <th scope="col">Forma de pago</th>
                                <th scope="col">Fecha</th>
                                <th scope="col" class="text-end">Total</th>
                                <th scope="col" class="text-end pe-3">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.CajaAbierta.Ventas != null && Model.CajaAbierta.Ventas.Any())
                            {
                                @foreach (var v in Model.CajaAbierta.Ventas.OrderByDescending(v => v.FolioVenta))
                                {
                                    <tr>
                                        <td class="ps-3">#@v.FolioVenta@(v.IdPedido != null ? $" (pedido #{v.IdPedido})" : "")</td>
                                        <td>@v.IdClienteNavigation?.Nombre</td>
                                        <td>@v.IdProductoNavigation?.Nombre</td>
                                        <td>@v.FormaPago</td>
                                        <td>@v.Fecha.ToString("dd/MM/yyyy")</td>
                                        <td class="text-end fw-bold">$@v.Total.ToString("0.00")</td>
                                        <td class="text-end pe-3">
                                            @if (v.Estado == "Activa")
                                            {
                                                @if (v.IdPedido == null)
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#modalCancelar_@v.FolioVenta">
                                                        <i class="bi bi-x-circle me-1"></i>Cancelar
                                                    </button>
                                                }
                                            }
                                            else if (v.Estado == "Cancelada")
                                            {
                                                <span class="badge bg-danger">Cancelada</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Devuelta</span>
                                            }
                                        </td>
                                    </tr>

                                    <div class="modal fade" id="modalCancelar_@v.FolioVenta" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <form method="post" asp-page-handler="CancelarVenta">
                                                    <div class="modal-header bg-danger text-white">
                                                        <h5 class="modal-title">Cancelar venta folio @v.FolioVenta</h5>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <input type="hidden" name="folioVenta" value="@v.FolioVenta" />
                                                        <p>Se devuelve <strong>$@v.Total.ToString("0.00")</strong> al cliente (reversión de caja) y se regresan <strong>@v.Cantidad</strong> unidades de <strong>@(v.IdProductoNavigation?.Nombre ?? "-")</strong> al inventario.</p>
                                                        <div class="mb-3">
                                                            <label class="form-label fw-semibold">Motivo de la cancelación *</label>
                                                            <textarea name="motivo" class="form-control" rows="2" required placeholder="Ej. el cliente se arrepintió, producto defectuoso..."></textarea>
                                                        </div>
                                                        @if (!User.IsInRole("Encargado") && !User.IsInRole("Admin"))
                                                        {
                                                        <p class="fw-bold small mb-2">Autorización del encargado *</p>
                                                        <div class="row g-2">
                                                            <div class="col-6"><input type="text" name="usuarioEncargado" class="form-control" placeholder="Usuario del encargado" /></div>
                                                            <div class="col-6"><input type="password" name="claveEncargado" class="form-control" placeholder="Clave del encargado" /></div>
                                                        </div>
                                                        <div class="mt-2"><input type="number" name="idAutorizacion" class="form-control" placeholder="O folio de autorización aprobada" /></div>
                                                        <small class="text-muted">Si ya tienes un folio aprobado, ponlo ahí y deja usuario/clave vacíos.</small>
                                                        }
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                                                        <button type="submit" class="btn btn-danger">Cancelar venta</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>

                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted">No hay ventas registradas en este turno.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<!-- Llamado al archivo de modales ubicado en la carpeta Modales -->
<partial name="~/Pages/Modales/_ModalesCaja.cshtml" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}