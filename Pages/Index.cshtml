@page
@model Proyecto.Pages.IndexModel
@{
    ViewData["Title"] = "Panel de Caja";
}

<div class="container-fluid py-4">
    <!-- Alertas de Éxito y Error -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-transparent border-0 py-3 d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-1 fw-bold">Panel de Control de Caja</h5>
                <p class="text-muted small mb-0">HU-19: Gestión de turnos y flujos de efectivo</p>
            </div>
        </div>
    </div>

    @if (Model.CajaAbierta == null)
    {
        <div class="card shadow-sm border-0 text-center py-5">
            <div class="card-body">
                <h4 class="fw-bold text-dark mb-3">No tienes ninguna caja abierta</h4>
                <p class="text-muted mb-4">Para comenzar a registrar ventas o movimientos, abre tu turno ingresando un fondo inicial.</p>
                <button type="button" class="btn btn-primary btn-lg px-5 rounded-pill shadow-sm" data-bs-toggle="modal" data-bs-target="#modalAbrirCaja">
                    Abrir Caja
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4 mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm bg-primary text-white h-100">
                    <div class="card-body">
                        <h6 class="text-white-50 text-uppercase fw-bold">Saldo Actual en Caja</h6>
                        <h2 class="fw-bold mb-0">$@Model.SaldoActual.ToString("0.00")</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <h6 class="text-muted text-uppercase fw-bold">Fondo Inicial</h6>
                        <h3 class="text-dark fw-bold mb-0">$@Model.CajaAbierta.FondoInicial.ToString("0.00")</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <h6 class="text-muted text-uppercase fw-bold">Entradas Manuales</h6>
                        <h3 class="text-success fw-bold mb-0">+$@Model.TotalEntradas.ToString("0.00")</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <h6 class="text-muted text-uppercase fw-bold">Salidas Manuales</h6>
                        <h3 class="text-danger fw-bold mb-0">-$@Model.TotalSalidas.ToString("0.00")</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-transparent border-bottom py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold">Movimientos Extra del Turno</h6>
                <div>
                    <button type="button" class="btn btn-outline-primary btn-sm me-2" data-bs-toggle="modal" data-bs-target="#modalMovimiento">
                        + Registrar Movimiento
                    </button>
                    <a asp-page="/Corte" class="btn btn-danger btn-sm">Hacer Corte de Caja</a>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive table-card">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="ps-3">Hora</th>
                                <th scope="col">Tipo</th>
                                <th scope="col">Motivo</th>
                                <th scope="col" class="text-end pe-3">Monto</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if(Model.CajaAbierta.MovimientoCajas != null && Model.CajaAbierta.MovimientoCajas.Any())
                            {
                                @foreach (var mov in Model.CajaAbierta.MovimientoCajas.OrderByDescending(m => m.Fecha))
                                {
                                    <tr>
                                        <td class="ps-3">@mov.Fecha.ToString("hh:mm tt")</td>
                                        <td>
                                            @if(mov.Tipo == "Entrada") {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Entrada</span>
                                            } else {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Salida</span>
                                            }
                                        </td>
                                        <td>@mov.Motivo</td>
                                        <td class="text-end pe-3 fw-bold @(mov.Tipo == "Entrada" ? "text-success" : "text-danger")">
                                            @(mov.Tipo == "Entrada" ? "+" : "-") $@mov.Monto.ToString("0.00")
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">No hay movimientos extra registrados en este turno.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<!-- Llamado al archivo de modales ubicado en la carpeta Modales (Ruta Absoluta Corregida) -->
<partial name="~/Pages/Modales/_ModalesCaja.cshtml" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}