@page
@model Proyecto.Pages.VentaCobroExamenModel
@{
    ViewData["Title"] = "Venta de Mostrador y Cobro de Examen";
}

<div class="container-fluid py-4">

    <!-- Encabezado Principal -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <h2 class="h5 mb-1 fw-bold">Venta de Mostrador y Cobro de Examen</h2>
                <p class="text-muted small mb-0">HU-09: Cobro directo de productos, accesorios y examen de la vista</p>
            </div>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">Rol: Vendedor</span>
        </div>
    </div>

    <!-- Alerta Dinámica de Respuesta AJAX -->
    <div id="alertaResultado" class="alert alert-dismissible fade show d-none shadow-sm mb-4" role="alert">
        <span id="alertaMensaje"></span>
        <button type="button" class="btn-close" onclick="cerrarAlerta()"></button>
    </div>

    <form id="formVenta" method="post" asp-page-handler="ProcesarVenta">
        @Html.AntiForgeryToken()
        <input type="hidden" id="clienteId" name="ClienteId" required />
        <input type="hidden" id="totalVentaInput" name="TotalVenta" value="0.00" />
        <div id="productosContainerOculto"></div>
        <div id="pagosContainerOculto"></div>
        <!-- HU-12.3: autorización del descuento manual (la llena autorizarDescuento). -->
        <input type="hidden" id="idAutorizacionDescuento" name="IdAutorizacionDescuento" />
        <input type="hidden" id="descuentoManualTipo" name="DescuentoManualTipo" />
        <input type="hidden" id="descuentoManualValor" name="DescuentoManualValor" value="0" />
        <!-- HU-12.1: efectivo recibido con forma única (lo llena ejecutarCobroAjax). -->
        <input type="hidden" id="efectivoRecibidoInput" name="EfectivoRecibido" />

        <div class="row g-4">
            <!-- COLUMNA IZQUIERDA -->
            <div class="col-lg-5">
                
                <!-- 1. Datos del Cliente -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-transparent border-0 pt-3 px-4 pb-0 d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0">Datos del Cliente</h5>
                        <span id="badgeBonificacion" class="badge bg-success-subtle text-success d-none">
                            <i class="bi bi-patch-check-fill me-1"></i>Examen Bonificado
                        </span>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3 position-relative">
                            <label class="form-label fw-semibold small">Nombre del Cliente</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person-fill"></i></span>
                                <input type="text" id="inputNombreCliente" class="form-control" placeholder="Buscar por nombre..." autocomplete="off" />
                            </div>
                            <ul id="sugerenciasClienteNombre" class="dropdown-menu w-100 shadow-sm" style="max-height: 180px; overflow-y: auto;"></ul>
                        </div>

                        <div class="mb-2 position-relative">
                            <label class="form-label fw-semibold small">Num. Teléfono</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-telephone-fill"></i></span>
                                <input type="text" id="inputTelefonoCliente" class="form-control" placeholder="Filtrar por 10 dígitos..." autocomplete="off" />
                            </div>
                            <ul id="sugerenciasClienteTel" class="dropdown-menu w-100 shadow-sm" style="max-height: 180px; overflow-y: auto;"></ul>
                        </div>

                        <!-- HU-09.1: alta rápida de cliente sin salir de la venta. -->
                        <div class="border rounded p-3 bg-light">
                            <div class="fw-semibold small mb-2"><i class="bi bi-person-plus me-1"></i> Cliente nuevo (alta rápida)</div>
                            <div class="row g-2">
                                <div class="col-7">
                                    <input type="text" id="inputNuevoClienteNombre" class="form-control form-control-sm" placeholder="Nombre completo" />
                                </div>
                                <div class="col-5">
                                    <input type="text" id="inputNuevoClienteTel" class="form-control form-control-sm" placeholder="Tel. 10 dígitos" maxlength="10" />
                                </div>
                            </div>
                            <button type="button" class="btn btn-outline-primary btn-sm w-100 mt-2" onclick="crearClienteRapido()">Crear y seleccionar cliente</button>
                            <div id="msgClienteRapido" class="small mt-1"></div>
                        </div>
                    </div>
                </div>

                <!-- 2. Productos y Detalles -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-transparent border-0 pt-3 px-4 pb-0">
                        <h5 class="fw-bold mb-0">Productos y Detalles</h5>
                    </div>
                    <div class="card-body p-4">
                        <label class="form-label fw-semibold small">Búsqueda de Producto</label>
                        <button type="button" class="btn btn-outline-primary w-100 text-start d-flex justify-content-between align-items-center py-2" onclick="abrirModalBusquedaProductos()">
                            <span><i class="bi bi-search me-2"></i> Buscar productos en catálogo...</span>
                            <i class="bi bi-plus-circle fw-bold"></i>
                        </button>
                    </div>
                </div>

                <!-- 3. Forma de Pago y Opciones Adicionales -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-transparent border-0 pt-3 px-4 pb-0">
                        <h5 class="fw-bold mb-0">Forma de Pago</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-cash-stack"></i></span>
                                <select id="formaPago" name="FormaPago" class="form-select" required>
                                    <option value="Efectivo" selected>Efectivo</option>
                                    <option value="Tarjeta">Tarjeta de Débito/Crédito</option>
                                    <option value="Transferencia">Transferencia Electrónica</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="incluyeExamen" name="IncluyeExamen" value="true" onchange="calcularTotalesGlobales()">
                            <label class="form-check-label fw-semibold small" for="incluyeExamen">
                                Incluir Examen de la Vista
                            </label>
                        </div>

                        <!-- HU-12.1: pago combinado (varias formas de pago). -->
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="pagoCombinado" onchange="togglePagoCombinado()">
                            <label class="form-check-label fw-semibold small" for="pagoCombinado">
                                Pago combinado (varias formas de pago)
                            </label>
                        </div>
                        <div id="seccionPagoCombinado" class="border rounded p-3 mb-2 bg-light d-none">
                            <div class="fw-semibold small mb-2">Pagos <span class="text-muted fw-normal">(la suma debe ser el total a cobrar)</span></div>
                            <div id="filasPago"></div>
                            <button type="button" class="btn btn-outline-secondary btn-sm w-100" onclick="agregarFilaPago()">+ Agregar otro pago</button>
                            <div id="msgPagoCombinado" class="small mt-1"></div>
                        </div>

                        <!-- HU-12.3: descuento manual autorizado por el encargado. Si quien vende ya es Encargado, lo autoriza directo con su sesión (sin pedir usuario y clave de otro encargado). -->
                        <div class="border rounded p-3 bg-light">
                            <div class="fw-semibold small mb-2"><i class="bi bi-percent me-1"></i> Descuento manual @(User.IsInRole("Encargado") || User.IsInRole("Admin") ? "(lo autorizas tú)" : "(requiere encargado)")</div>
                            <div class="row g-2 mb-2">
                                <div class="col-5">
                                    <select id="inputDescTipo" class="form-select form-select-sm">
                                        <option value="Porcentaje">Porcentaje (%)</option>
                                        <option value="Monto">Monto ($)</option>
                                    </select>
                                </div>
                                <div class="col-7">
                                    <input type="number" id="inputDescValor" class="form-control form-control-sm" placeholder="Valor" step="0.01" min="0" />
                                </div>
                            </div>
                            <input type="text" id="inputDescMotivo" class="form-control form-control-sm mb-2" placeholder="Motivo del descuento" />
                            @if (!(User.IsInRole("Encargado") || User.IsInRole("Admin")))
                            {
                                <div class="row g-2 mb-2">
                                    <div class="col-6">
                                        <input type="text" id="inputDescUsuario" class="form-control form-control-sm" placeholder="Usuario encargado" />
                                    </div>
                                    <div class="col-6">
                                        <input type="password" id="inputDescClave" class="form-control form-control-sm" placeholder="Clave encargado" />
                                    </div>
                                </div>
                            }
                            <button type="button" class="btn btn-outline-warning btn-sm w-100" onclick="autorizarDescuento()">@(User.IsInRole("Encargado") || User.IsInRole("Admin") ? "Aplicar descuento" : "Autorizar descuento")</button>
                            <div id="msgDescuento" class="small mt-1"></div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- COLUMNA DERECHA -->
            <div class="col-lg-7">
                
                <!-- Tabla de Productos en el Carrito -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-transparent border-0 pt-3 px-4 pb-0">
                        <h5 class="fw-bold mb-0">Productos Seleccionados</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="table-responsive table-card border rounded" style="max-height: 280px; overflow-y: auto;">
                            <table class="table table-striped table-hover align-middle mb-0" id="tablaCarrito">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th class="ps-3">Nombre Producto</th>
                                        <th class="text-center" style="width: 140px;">Cantidad</th>
                                        <th class="text-end">P. unitario</th>
                                        <th class="text-end pe-3">Subtotal</th>
                                        <th class="text-center" style="width: 50px;"></th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyCarrito">
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">No hay productos agregados. Usa "Búsqueda de Producto".</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Resumen de la Operación -->
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Subtotal Productos:</span>
                            <span id="lblSubtotal" class="fw-semibold">$0.00 MXN</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Costo Examen:</span>
                            <span id="lblCostoExamen" class="fw-semibold">$0.00 MXN</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3 text-success">
                            <span>Bonificación Examen (Receta &le; 30 días):</span>
                            <span id="lblBonificacion" class="fw-semibold">-$0.00 MXN</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 text-success">
                            <span>Crédito de examen pagado (HU-09.3):</span>
                            <span id="lblCreditoExamen" class="fw-semibold">-$0.00 MXN</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 text-success">
                            <span>Promociones aplicadas:</span>
                            <span id="lblPromociones" class="fw-semibold">-$0.00 MXN</span>
                        </div>
                        <div id="detallePromociones" class="small text-muted mb-2"></div>
                        <div class="d-flex justify-content-between mb-2 text-success">
                            <span>Descuento manual autorizado:</span>
                            <span id="lblDescuentoManual" class="fw-semibold">-$0.00 MXN</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <span class="h5 mb-0 fw-bold">Total a cobrar:</span>
                            <span id="lblTotalCobrar" class="h3 mb-0 fw-bold text-primary">$0.00 MXN</span>
                        </div>

                        <button type="button" class="btn btn-success w-100 py-3 fw-bold fs-5 shadow-sm" onclick="validarYMostrarModalPago()">
                            <i class="bi bi-cash-stack me-2"></i> Procesar Cobro
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </form>
</div>

<!-- ================= MODAL DE BÚSQUEDA DE PRODUCTOS ================= -->
<div class="modal fade" id="modalBusquedaProductos" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-search me-2"></i> Catálogo de Productos y Stock</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-3 mb-3">
                    <div class="col-md-8">
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-funnel"></i></span>
                            <input type="text" id="modalInputBuscar" class="form-control" placeholder="Buscar por nombre, categoría o código (ej. PRD-007)..." oninput="filtrarProductosModal()" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <button type="button" class="btn btn-outline-secondary w-100" onclick="cargarProductosModal()">
                            <i class="bi bi-arrow-clockwise me-1"></i> Actualizar Lista
                        </button>
                    </div>
                </div>

                <div class="table-responsive border rounded" style="max-height: 350px;">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th class="text-center" style="width: 50px;">Sel.</th>
                                <th class="ps-3">Nombre</th>
                                <th>Categoría</th>
                                <th class="text-center">Disponible</th>
                                <th class="text-end pe-3">Precio</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyModalProductos">
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">Cargando productos...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer bg-light border-0">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary px-4 fw-bold" onclick="agregarProductosSeleccionados()">
                    <i class="bi bi-check2-all me-1"></i> Añadir Seleccionados al Carrito
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ================= MODAL DE PROCESAR COBRO ================= -->
<div class="modal fade" id="modalProcesarCobro" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-cash-register me-2"></i> Finalizar Cobro</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="text-center mb-4">
                    <span class="text-muted d-block small">Monto Total a Pagar</span>
                    <h2 class="fw-bold text-primary" id="modalMontoTotalTexto">$0.00 MXN</h2>
                </div>

                <!-- Pago en Efectivo -->
                <div id="seccionEfectivo" class="mb-3">
                    <label class="form-label fw-semibold">Cantidad Recibida en Efectivo</label>
                    <div class="input-group input-group-lg mb-3">
                        <span class="input-group-text">$</span>
                        <input type="number" id="inputEfectivoRecibido" class="form-control" placeholder="0.00" step="0.50" min="0" oninput="calcularCambioEfectivo()" />
                        <span class="input-group-text">MXN</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded border">
                        <span class="fw-bold text-secondary">Cambio a Devolver:</span>
                        <span id="lblCambioDevolver" class="h4 mb-0 fw-bold text-success">$0.00 MXN</span>
                    </div>
                </div>

                <!-- Pago Electrónico -->
                <div id="seccionElectronico" class="mb-3 d-none text-center p-3 bg-light rounded border">
                    <p class="mb-0 text-muted">El cobro se registrará mediante <strong id="lblMetodoPagoText">Tarjeta</strong>.</p>
                    <div class="mt-3 text-start">
                        <label class="form-label fw-semibold small">Referencia (autorización o folio)</label>
                        <input type="text" id="inputReferenciaUnica" class="form-control" placeholder="Ej. AUT-123456" />
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light border-0 justify-content-center py-3">
                <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="btnConfirmarAjax" class="btn btn-success px-4 fw-bold" onclick="ejecutarCobroAjax()">
                    <i class="bi bi-check-circle me-1"></i> Confirmar y Cobrar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let carritoProductos = [];
        let catalogoProductosGlobal = [];
        let precioExamenBase = 250.00;
        let clienteTieneBonificacion = false;
        // HU-09.3 / HU-12.2 / HU-12.3: estado de descuentos (el servidor recalcula todo).
        let clienteTieneCreditoExamen = false;
        let promoDescuento = 0.00;
        let descuentoManualMonto = 0.00;

        document.addEventListener("DOMContentLoaded", function () {
            inicializarBusquedaCliente();
            cargarParametrosNegocio();
        });

        // ================= 1. BÚSQUEDA DUAL DE CLIENTE =================
        function inicializarBusquedaCliente() {
            const inputNombre = document.getElementById('inputNombreCliente');
            const ulNombre = document.getElementById('sugerenciasClienteNombre');
            const inputTel = document.getElementById('inputTelefonoCliente');
            const ulTel = document.getElementById('sugerenciasClienteTel');
            const inputHiddenId = document.getElementById('clienteId');

            const seleccionarCliente = (c) => {
                inputNombre.value = c.nombre;
                inputTel.value = c.telefono || '';
                inputHiddenId.value = c.id;
                ulNombre.classList.remove('show');
                ulTel.classList.remove('show');
                verificarBonificacionCliente(c.id);
            };

            const buscarYRenderizar = (query, ulElement, mostrarTelPrimero) => {
                if (query.length < 2) { ulElement.classList.remove('show'); return; }

                fetch(`?handler=BuscarClientes&criterio=${encodeURIComponent(query)}`)
                    .then(res => res.json())
                    .then(data => {
                        ulElement.innerHTML = '';
                        if (data.length === 0) {
                            ulElement.innerHTML = '<li class="dropdown-item text-muted disabled">Sin coincidencias</li>';
                        } else {
                            data.forEach(c => {
                                const li = document.createElement('li');
                                li.className = 'dropdown-item d-flex justify-content-between align-items-center';
                                li.style.cursor = 'pointer';
                                li.innerHTML = mostrarTelPrimero
                                    ? `<span>${c.nombre}</span> <small class="text-muted fw-bold">${c.telefono || 'Sin tel'}</small>`
                                    : `<span><strong>${c.nombre}</strong></span> <small class="text-muted">${c.telefono || 'Sin tel'}</small>`;
                                li.onclick = () => seleccionarCliente(c);
                                ulElement.appendChild(li);
                            });
                        }
                        ulElement.classList.add('show');
                    });
            };

            inputNombre.addEventListener('input', function () {
                inputHiddenId.value = '';
                clienteTieneBonificacion = false;
                document.getElementById('badgeBonificacion').classList.add('d-none');
                calcularTotalesGlobales();
                buscarYRenderizar(this.value.trim(), ulNombre, false);
            });

            inputTel.addEventListener('input', function () {
                inputHiddenId.value = '';
                clienteTieneBonificacion = false;
                document.getElementById('badgeBonificacion').classList.add('d-none');
                calcularTotalesGlobales();
                buscarYRenderizar(this.value.trim(), ulTel, true);
            });

            document.addEventListener('click', function (e) {
                if (!inputNombre.contains(e.target) && !ulNombre.contains(e.target)) ulNombre.classList.remove('show');
                if (!inputTel.contains(e.target) && !ulTel.contains(e.target)) ulTel.classList.remove('show');
            });
        }

        function verificarBonificacionCliente(clienteId) {
            fetch(`?handler=ConsultarProducto&idProducto=0&idCliente=${clienteId}`)
                .then(res => res.json())
                .then(data => {
                    clienteTieneBonificacion = data.aplicaBonificacion || false;
                    // HU-09.3: examen pagado sin usar dentro de la vigencia.
                    clienteTieneCreditoExamen = !clienteTieneBonificacion && (data.tieneCreditoExamen || false);
                    const badge = document.getElementById('badgeBonificacion');
                    if (clienteTieneBonificacion) {
                        badge.classList.remove('d-none');
                    } else {
                        badge.classList.add('d-none');
                    }
                    calcularTotalesGlobales();
                }).catch(() => { clienteTieneBonificacion = false; clienteTieneCreditoExamen = false; });
        }

        function cargarParametrosNegocio() {
            fetch(`?handler=ConsultarProducto&idProducto=0&idCliente=0`)
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        precioExamenBase = data.precioExamen || 250.00;
                    }
                }).catch(() => {});
        }

        // ================= 2. MODAL Y CATÁLOGO DE PRODUCTOS =================
        function abrirModalBusquedaProductos() {
            document.getElementById('modalInputBuscar').value = '';
            var modal = new bootstrap.Modal(document.getElementById('modalBusquedaProductos'));
            modal.show();
            cargarProductosModal();
        }

        function cargarProductosModal() {
            const tbody = document.getElementById('tbodyModalProductos');
            tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-4">Buscando productos...</td></tr>';

            fetch(`?handler=BuscarProductos&criterio=`)
                .then(res => res.json())
                .then(data => {
                    catalogoProductosGlobal = data;
                    renderizarTablaModal(data);
                })
                .catch(() => {
                    tbody.innerHTML = '<tr><td colspan="5" class="text-center text-danger py-4">Error al cargar el catálogo.</td></tr>';
                });
        }

        function renderizarTablaModal(productos) {
            const tbody = document.getElementById('tbodyModalProductos');
            tbody.innerHTML = '';
            if (productos.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-4">No hay productos disponibles.</td></tr>';
                return;
            }

            productos.forEach(p => {
                // Restar lo que ya está en el carrito para mostrar disponibilidad real
                const enCarrito = carritoProductos.find(item => item.id === p.id);
                const cantEnCarrito = enCarrito ? enCarrito.cantidad : 0;
                const stockRestante = Math.max(0, p.existencia - cantEnCarrito);

                const tr = document.createElement('tr');
                const badgeClass = stockRestante > 0 ? 'bg-success' : 'bg-danger';
                tr.innerHTML = `
                    <td class="text-center">
                        <input class="form-check-input check-prod-modal" type="checkbox" value="${p.id}" 
                               data-nombre="${p.nombre}" data-precio="${p.precio}" data-stock="${p.existencia}" 
                               ${stockRestante <= 0 ? 'disabled' : ''}>
                    </td>
                    <td class="ps-3 fw-medium">
                        ${p.nombre} 
                        ${cantEnCarrito > 0 ? `<small class="text-primary d-block">(${cantEnCarrito} en carrito)</small>` : ''}
                    </td>
                    <td><span class="badge bg-secondary-subtle text-secondary">${p.categoria}</span></td>
                    <td class="text-center"><span class="badge ${badgeClass}">${stockRestante}</span></td>
                    <td class="text-end pe-3 fw-bold text-primary">$${p.precio.toFixed(2)} MXN</td>
                `;
                tbody.appendChild(tr);
            });
        }

        function filtrarProductosModal() {
            const query = document.getElementById('modalInputBuscar').value.toLowerCase().trim();
            const filtrados = catalogoProductosGlobal.filter(p =>
                p.nombre.toLowerCase().includes(query) || p.categoria.toLowerCase().includes(query)
                || p.id.toString() === query || ('prd-' + p.id.toString().padStart(3, '0')) === query
            );
            renderizarTablaModal(filtrados);
        }

        function agregarProductosSeleccionados() {
            const checkboxes = document.querySelectorAll('.check-prod-modal:checked');
            if (checkboxes.length === 0) {
                alert("Selecciona al menos un producto disponible.");
                return;
            }

            checkboxes.forEach(chk => {
                const id = parseInt(chk.value);
                const nombre = chk.getAttribute('data-nombre');
                const precio = parseFloat(chk.getAttribute('data-precio'));
                const stockMax = parseInt(chk.getAttribute('data-stock'));

                const existente = carritoProductos.find(item => item.id === id);
                if (existente) {
                    if (existente.cantidad < stockMax) {
                        existente.cantidad += 1;
                    }
                } else if (stockMax > 0) {
                    carritoProductos.push({
                        id: id,
                        nombre: nombre,
                        precioUnitario: precio,
                        cantidad: 1,
                        stockMax: stockMax
                    });
                }
            });

            bootstrap.Modal.getInstance(document.getElementById('modalBusquedaProductos')).hide();
            actualizarTablaCarrito();
            calcularTotalesGlobales();
        }

        // ================= 3. CARRITO Y CANTIDADES =================
        function cambiarCantidad(id, delta) {
            const item = carritoProductos.find(i => i.id === id);
            if (!item) return;

            item.cantidad += delta;
            if (item.cantidad <= 0) {
                carritoProductos = carritoProductos.filter(i => i.id !== id);
            } else if (item.cantidad > item.stockMax) {
                item.cantidad = item.stockMax;
                mostrarAlerta(`Stock máximo alcanzado para "${item.nombre}" (${item.stockMax} disponibles).`, "warning");
            }

            actualizarTablaCarrito();
            calcularTotalesGlobales();
        }

        function eliminarDelCarrito(id) {
            carritoProductos = carritoProductos.filter(i => i.id !== id);
            actualizarTablaCarrito();
            calcularTotalesGlobales();
        }

        function actualizarTablaCarrito() {
            const tbody = document.getElementById('tbodyCarrito');
            const containerOculto = document.getElementById('productosContainerOculto');
            tbody.innerHTML = '';
            containerOculto.innerHTML = '';

            if (carritoProductos.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="text-center text-muted py-4">No hay productos agregados. Usa "Búsqueda de Producto".</td></tr>`;
                return;
            }

            carritoProductos.forEach((item, index) => {
                const totalLinea = item.precioUnitario * item.cantidad;

                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="ps-3 fw-medium">${item.nombre}</td>
                    <td class="text-center">
                        <div class="input-group input-group-sm justify-content-center">
                            <button type="button" class="btn btn-outline-secondary px-2" onclick="cambiarCantidad(${item.id}, -1)">-</button>
                            <span class="px-3 py-1 bg-light border fw-semibold">${item.cantidad}</span>
                            <button type="button" class="btn btn-outline-secondary px-2" onclick="cambiarCantidad(${item.id}, 1)">+</button>
                        </div>
                    </td>
                    <td class="text-end">$${item.precioUnitario.toFixed(2)} MXN</td>
                    <td class="text-end pe-3 fw-bold">$${totalLinea.toFixed(2)} MXN</td>
                    <td class="text-center">
                        <button type="button" class="btn btn-sm text-danger" onclick="eliminarDelCarrito(${item.id})"><i class="bi bi-trash"></i></button>
                    </td>
                `;
                tbody.appendChild(tr);

                // Generar inputs indexados para que ASP.NET Core los vincule a List<ItemVentaDto> Items
                const inputId = document.createElement('input');
                inputId.type = 'hidden';
                inputId.name = `Items[${index}].ProductoId`;
                inputId.value = item.id;
                containerOculto.appendChild(inputId);

                const inputCant = document.createElement('input');
                inputCant.type = 'hidden';
                inputCant.name = `Items[${index}].Cantidad`;
                inputCant.value = item.cantidad;
                containerOculto.appendChild(inputCant);
            });

            // HU-12.2: al cambiar el carrito se vuelven a consultar las promociones.
            actualizarPromociones();
        }

        // ================= 4. CÁLCULO DE TOTALES =================
        function calcularTotalesGlobales() {
            let subtotalProductos = carritoProductos.reduce((acc, item) => acc + (item.precioUnitario * item.cantidad), 0);

            const incluyeExamen = document.getElementById('incluyeExamen').checked;
            let costoExamen = incluyeExamen ? precioExamenBase : 0.00;

            // Bonificación real: solo si incluye examen y el cliente tiene receta vigente (<= 30 días)
            let bonificacion = (incluyeExamen && clienteTieneBonificacion) ? precioExamenBase : 0.00;

            // HU-09.3: crédito de examen pagado (solo si no hay bonificación por receta).
            let creditoExamen = (!clienteTieneBonificacion && clienteTieneCreditoExamen) ? precioExamenBase : 0.00;

            // HU-12.2 / HU-12.3: promociones y descuento manual (el servidor recalcula).
            let totalCobrar = Math.max(0, subtotalProductos + costoExamen - bonificacion - creditoExamen - promoDescuento - descuentoManualMonto);

            document.getElementById('lblSubtotal').textContent = `$${subtotalProductos.toFixed(2)} MXN`;
            document.getElementById('lblCostoExamen').textContent = `$${costoExamen.toFixed(2)} MXN`;
            document.getElementById('lblBonificacion').textContent = `-$${bonificacion.toFixed(2)} MXN`;
            document.getElementById('lblCreditoExamen').textContent = `-$${creditoExamen.toFixed(2)} MXN`;
            document.getElementById('lblPromociones').textContent = `-$${promoDescuento.toFixed(2)} MXN`;
            document.getElementById('lblDescuentoManual').textContent = `-$${descuentoManualMonto.toFixed(2)} MXN`;
            document.getElementById('lblTotalCobrar').textContent = `$${totalCobrar.toFixed(2)} MXN`;
            document.getElementById('totalVentaInput').value = totalCobrar.toFixed(2);
        }

        // HU-12.2: consulta las promociones aplicables al carrito actual y
        // actualiza la sugerencia con su desglose.
        function actualizarPromociones() {
            if (carritoProductos.length === 0) {
                promoDescuento = 0.00;
                document.getElementById('detallePromociones').textContent = '';
                calcularTotalesGlobales();
                return;
            }
            const ids = [...new Set(carritoProductos.map(i => i.id))].join(',');
            fetch(`?handler=Promociones&productosIds=${encodeURIComponent(ids)}`)
                .then(res => res.json())
                .then(data => {
                    promoDescuento = data.success ? (data.descuento || 0) : 0;
                    document.getElementById('detallePromociones').textContent =
                        (data.detalle || []).map(d => `${d.nombre} (${d.tipo}): -$${d.monto.toFixed(2)}`).join(' · ');
                    calcularTotalesGlobales();
                })
                .catch(() => { promoDescuento = 0.00; calcularTotalesGlobales(); });
        }

        // HU-09.1: alta rápida de cliente.
        function crearClienteRapido() {
            const nombre = document.getElementById('inputNuevoClienteNombre').value.trim();
            const telefono = document.getElementById('inputNuevoClienteTel').value.trim();
            const msg = document.getElementById('msgClienteRapido');
            if (!nombre) { msg.textContent = 'Escribe el nombre del cliente.'; msg.className = 'small mt-1 text-danger'; return; }

            const formData = new FormData();
            formData.append('nombre', nombre);
            formData.append('telefono', telefono);
            fetch('?handler=CrearClienteRapido', {
                method: 'POST',
                body: formData,
                headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' }
            })
            .then(res => res.json())
            .then(data => {
                if (!data.success) { msg.textContent = data.message; msg.className = 'small mt-1 text-danger'; return; }
                document.getElementById('inputNombreCliente').value = data.nombre;
                document.getElementById('inputTelefonoCliente').value = data.telefono || '';
                document.getElementById('clienteId').value = data.id;
                msg.textContent = data.mensaje || 'Cliente creado.';
                msg.className = 'small mt-1 text-success';
                verificarBonificacionCliente(data.id);
            })
            .catch(() => { msg.textContent = 'No se pudo crear el cliente.'; msg.className = 'small mt-1 text-danger'; });
        }

        // HU-12.3: pide la autorización del descuento manual al encargado.
        // Si quien vende ya es Encargado, no se piden usuario y clave: el
        // servidor lo autoriza directo con su sesión.
        function autorizarDescuento() {
            const esEncargado = @(User.IsInRole("Encargado") || User.IsInRole("Admin") ? "true" : "false");
            const tipo = document.getElementById('inputDescTipo').value;
            const valor = parseFloat(document.getElementById('inputDescValor').value) || 0;
            const motivo = document.getElementById('inputDescMotivo').value.trim();
            const usuario = document.getElementById('inputDescUsuario')?.value.trim() ?? '';
            const clave = document.getElementById('inputDescClave')?.value ?? '';
            const msg = document.getElementById('msgDescuento');
            if (valor <= 0 || !motivo || (!esEncargado && (!usuario || !clave))) {
                msg.textContent = esEncargado ? 'Llena valor y motivo.' : 'Llena valor, motivo, usuario y clave del encargado.';
                msg.className = 'small mt-1 text-danger';
                return;
            }
            const formData = new FormData();
            formData.append('tipo', tipo);
            formData.append('valor', valor);
            formData.append('motivo', motivo);
            formData.append('usuarioEncargado', usuario);
            formData.append('claveEncargado', clave);
            fetch('?handler=AutorizarDescuento', {
                method: 'POST',
                body: formData,
                headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' }
            })
            .then(res => res.json())
            .then(data => {
                if (!data.success) { msg.textContent = data.message; msg.className = 'small mt-1 text-danger'; return; }
                document.getElementById('idAutorizacionDescuento').value = data.idAutorizacion;
                document.getElementById('descuentoManualTipo').value = tipo;
                document.getElementById('descuentoManualValor').value = valor;
                const subtotal = carritoProductos.reduce((acc, i) => acc + (i.precioUnitario * i.cantidad), 0);
                descuentoManualMonto = tipo === 'Porcentaje'
                    ? Math.round((subtotal - promoDescuento) * valor / 100 * 100) / 100
                    : Math.min(valor, Math.max(0, subtotal - promoDescuento));
                msg.textContent = 'Descuento autorizado por el encargado.';
                msg.className = 'small mt-1 text-success';
                calcularTotalesGlobales();
            })
            .catch(() => { msg.textContent = 'No se pudo autorizar el descuento.'; msg.className = 'small mt-1 text-danger'; });
        }

        // HU-12.1: pago combinado.
        function togglePagoCombinado() {
            const activo = document.getElementById('pagoCombinado').checked;
            document.getElementById('seccionPagoCombinado').classList.toggle('d-none', !activo);
            if (activo && document.querySelectorAll('#filasPago .fila-pago').length === 0) {
                agregarFilaPago();
            }
            if (!activo) {
                document.getElementById('filasPago').innerHTML = '';
                document.getElementById('msgPagoCombinado').textContent = '';
            }
        }

        function agregarFilaPago() {
            const cont = document.getElementById('filasPago');
            const idx = cont.querySelectorAll('.fila-pago').length;
            const div = document.createElement('div');
            div.className = 'fila-pago row g-2 mb-2';
            div.innerHTML = `
                <div class="col-4">
                    <select class="form-select form-select-sm sel-forma-pago" onchange="actualizarFilaPago(this)">
                        <option value="Efectivo">Efectivo</option>
                        <option value="Tarjeta">Tarjeta</option>
                        <option value="Transferencia">Transferencia</option>
                    </select>
                </div>
                <div class="col-4">
                    <input type="number" class="form-control form-control-sm inp-monto-pago" placeholder="Monto" step="0.01" min="0" />
                </div>
                <div class="col-4">
                    <input type="text" class="form-control form-control-sm inp-ref-pago" placeholder="Referencia" />
                </div>
                <div class="col-12 campo-recibido">
                    <input type="number" class="form-control form-control-sm inp-recibido-pago" placeholder="Efectivo recibido (opcional, por defecto = monto)" step="0.01" min="0" />
                </div>`;
            cont.appendChild(div);
            if (idx === 0) {
                const total = parseFloat(document.getElementById('totalVentaInput').value) || 0;
                div.querySelector('.inp-monto-pago').value = total.toFixed(2);
            }
        }

        function actualizarFilaPago(sel) {
            const fila = sel.closest('.fila-pago');
            const recibido = fila.querySelector('.campo-recibido');
            recibido.classList.toggle('d-none', sel.value !== 'Efectivo');
        }

        // Construye los inputs Pagos[i] para el POST. Devuelve false si la
        // suma no coincide con el total o falta una referencia.
        function construirPagosOcultos() {
            const cont = document.getElementById('pagosContainerOculto');
            cont.innerHTML = '';
            document.getElementById('efectivoRecibidoInput').value = '';
            const total = parseFloat(document.getElementById('totalVentaInput').value) || 0;

            if (!document.getElementById('pagoCombinado').checked) {
                const formaPago = document.getElementById('formaPago').value;
                if (formaPago === 'Efectivo') {
                    document.getElementById('efectivoRecibidoInput').value = document.getElementById('inputEfectivoRecibido').value || '';
                } else {
                    const ref = document.getElementById('inputReferenciaUnica').value.trim();
                    if (!ref) { alert('El pago con ' + formaPago + ' necesita su referencia (autorización o folio).'); return false; }
                    agregarPagoOculto(cont, 0, formaPago, total, ref, null);
                }
                return true;
            }

            const filas = document.querySelectorAll('#filasPago .fila-pago');
            if (filas.length === 0) { document.getElementById('msgPagoCombinado').textContent = 'Agrega al menos un pago.'; return false; }
            let suma = 0;
            for (let i = 0; i < filas.length; i++) {
                const forma = filas[i].querySelector('.sel-forma-pago').value;
                const monto = parseFloat(filas[i].querySelector('.inp-monto-pago').value) || 0;
                const ref = filas[i].querySelector('.inp-ref-pago').value.trim();
                const recibido = filas[i].querySelector('.inp-recibido-pago').value;
                if (monto <= 0) { document.getElementById('msgPagoCombinado').textContent = 'Cada pago debe ser mayor a $0.00.'; return false; }
                if ((forma === 'Tarjeta' || forma === 'Transferencia') && !ref) {
                    document.getElementById('msgPagoCombinado').textContent = 'El pago con ' + forma + ' necesita su referencia.';
                    return false;
                }
                suma += monto;
                agregarPagoOculto(cont, i, forma, monto, ref || null, forma === 'Efectivo' && recibido ? recibido : null);
            }
            if (Math.abs(suma - total) > 0.01) {
                document.getElementById('msgPagoCombinado').textContent = `La suma de los pagos ($${suma.toFixed(2)}) no coincide con el total ($${total.toFixed(2)}).`;
                return false;
            }
            document.getElementById('msgPagoCombinado').textContent = '';
            return true;
        }

        function agregarPagoOculto(cont, i, forma, monto, ref, recibido) {
            const mk = (name, value) => {
                const inp = document.createElement('input');
                inp.type = 'hidden';
                inp.name = name;
                inp.value = value;
                cont.appendChild(inp);
            };
            mk(`Pagos[${i}].FormaPago`, forma);
            mk(`Pagos[${i}].Monto`, monto.toFixed(2));
            if (ref) mk(`Pagos[${i}].Referencia`, ref);
            if (recibido) mk(`Pagos[${i}].EfectivoRecibido`, recibido);
        }

        // ================= 5. VALIDACIÓN Y COBRO ASÍNCRONO (AJAX) =================
        function validarYMostrarModalPago() {
            const clienteId = document.getElementById('clienteId').value;
            const total = parseFloat(document.getElementById('totalVentaInput').value) || 0;

            if (!clienteId || parseInt(clienteId) <= 0) {
                mostrarAlerta("Por favor selecciona un cliente válido de la lista desplegable.", "danger");
                return;
            }
            if (carritoProductos.length === 0) {
                mostrarAlerta("Debes agregar al menos un producto al carrito.", "danger");
                return;
            }
            if (total <= 0) {
                mostrarAlerta("El total a cobrar debe ser mayor a $0.00 MXN.", "warning");
                return;
            }

            cerrarAlerta();
            const formaPago = document.getElementById('formaPago').value;
            const combinado = document.getElementById('pagoCombinado').checked;
            document.getElementById('modalMontoTotalTexto').textContent = `$${total.toFixed(2)} MXN`;

            const seccionEfectivo = document.getElementById('seccionEfectivo');
            const seccionElectronico = document.getElementById('seccionElectronico');

            if (combinado) {
                // HU-12.1: el desglose ya está en la sección de pago combinado.
                seccionEfectivo.classList.add('d-none');
                seccionElectronico.classList.add('d-none');
            } else if (formaPago === 'Efectivo') {
                seccionEfectivo.classList.remove('d-none');
                seccionElectronico.classList.add('d-none');
                document.getElementById('inputEfectivoRecibido').value = '';
                document.getElementById('lblCambioDevolver').textContent = '$0.00 MXN';
            } else {
                seccionEfectivo.classList.add('d-none');
                seccionElectronico.classList.remove('d-none');
                document.getElementById('lblMetodoPagoText').textContent = formaPago;
            }

            new bootstrap.Modal(document.getElementById('modalProcesarCobro')).show();
        }

        function calcularCambioEfectivo() {
            const total = parseFloat(document.getElementById('totalVentaInput').value) || 0;
            const recibido = parseFloat(document.getElementById('inputEfectivoRecibido').value) || 0;
            const cambio = recibido - total;

            const lblCambio = document.getElementById('lblCambioDevolver');
            if (cambio >= 0) {
                lblCambio.textContent = `$${cambio.toFixed(2)} MXN`;
                lblCambio.className = "h4 mb-0 fw-bold text-success";
            } else {
                lblCambio.textContent = `Faltan $${Math.abs(cambio).toFixed(2)} MXN`;
                lblCambio.className = "h4 mb-0 fw-bold text-danger";
            }
        }

        function ejecutarCobroAjax() {
            const combinado = document.getElementById('pagoCombinado').checked;
            if (!combinado) {
                const formaPago = document.getElementById('formaPago').value;
                if (formaPago === 'Efectivo') {
                    const total = parseFloat(document.getElementById('totalVentaInput').value) || 0;
                    const recibido = parseFloat(document.getElementById('inputEfectivoRecibido').value) || 0;
                    if (recibido < total) {
                        alert("La cantidad recibida en efectivo es menor al total a cobrar.");
                        return;
                    }
                }
            }
            // HU-12.1: construye los inputs Pagos[i] y valida suma/referencias.
            if (!construirPagosOcultos()) return;

            const btnConfirmar = document.getElementById('btnConfirmarAjax');
            btnConfirmar.disabled = true;
            btnConfirmar.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Procesando...';

            const form = document.getElementById('formVenta');
            const formData = new FormData(form);

            fetch('?handler=ProcesarVenta', {
                method: 'POST',
                body: formData,
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                }
            })
            .then(async response => {
                if (!response.ok) {
                    const errorText = await response.text();
                    throw new Error(errorText || "Error al procesar la venta.");
                }
                return response.json();
            })
            .then(data => {
                bootstrap.Modal.getInstance(document.getElementById('modalProcesarCobro')).hide();

                if (data.success) {
                    mostrarAlerta(`Venta #${data.folioVenta} registrada. Total cobrado: $${data.montoCobrado.toFixed(2)} MXN`, "success");
                    // HU-12.5: enlace al ticket imprimible de esta venta.
                    document.getElementById('alertaMensaje').innerHTML += ` <a href="/Ticket?folioVenta=${data.folioVenta}" target="_blank" class="alert-link">Ver ticket</a>`;
                    resetearFormularioCompleto();
                } else {
                    mostrarAlerta("No se pudo completar el cobro.", "warning");
                }
            })
            .catch(error => {
                bootstrap.Modal.getInstance(document.getElementById('modalProcesarCobro')).hide();
                mostrarAlerta(error.message, "danger");
            })
            .finally(() => {
                btnConfirmar.disabled = false;
                btnConfirmar.innerHTML = '<i class="bi bi-check-circle me-1"></i> Confirmar y Cobrar';
            });
        }

        function resetearFormularioCompleto() {
            document.getElementById('formVenta').reset();
            document.getElementById('clienteId').value = '';
            document.getElementById('badgeBonificacion').classList.add('d-none');
            carritoProductos = [];
            clienteTieneBonificacion = false;
            clienteTieneCreditoExamen = false;
            promoDescuento = 0.00;
            descuentoManualMonto = 0.00;
            document.getElementById('detallePromociones').textContent = '';
            document.getElementById('idAutorizacionDescuento').value = '';
            document.getElementById('descuentoManualTipo').value = '';
            document.getElementById('descuentoManualValor').value = '0';
            document.getElementById('inputDescValor').value = '';
            document.getElementById('inputDescMotivo').value = '';
            document.getElementById('inputDescUsuario').value = '';
            document.getElementById('inputDescClave').value = '';
            document.getElementById('msgDescuento').textContent = '';
            document.getElementById('inputNuevoClienteNombre').value = '';
            document.getElementById('inputNuevoClienteTel').value = '';
            document.getElementById('msgClienteRapido').textContent = '';
            document.getElementById('pagoCombinado').checked = false;
            document.getElementById('seccionPagoCombinado').classList.add('d-none');
            document.getElementById('filasPago').innerHTML = '';
            document.getElementById('msgPagoCombinado').textContent = '';
            document.getElementById('pagosContainerOculto').innerHTML = '';
            actualizarTablaCarrito();
            calcularTotalesGlobales();
        }

        function mostrarAlerta(mensaje, tipo) {
            const alerta = document.getElementById('alertaResultado');
            const texto = document.getElementById('alertaMensaje');
            alerta.className = `alert alert-${tipo} alert-dismissible fade show shadow-sm mb-4`;
            texto.textContent = mensaje;
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function cerrarAlerta() {
            document.getElementById('alertaResultado').classList.add('d-none');
        }
    </script>
}