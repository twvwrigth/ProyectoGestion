@page
@model Proyecto.Pages.VentaCobroExamenModel
@{
    ViewData["Title"] = "Venta de Mostrador y Cobro de Examen";
}

<div class="container-fluid py-4">

    <!-- Encabezado Principal de la Vista -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <h2 class="h5 mb-1 fw-bold">Venta de Mostrador y Cobro de Examen</h2>
                <p class="text-muted small mb-0">HU-09: Cobro directo de productos de stock, accesorios y examen de la vista</p>
            </div>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">Rol: Vendedor</span>
        </div>
    </div>

    <!-- Alerta de Respuesta (Éxito o Error) -->
    <div id="alertaResultado" class="alert alert-dismissible fade show d-none shadow-sm mb-4" role="alert">
        <span id="alertaMensaje"></span>
        <button type="button" class="btn-close" onclick="cerrarAlerta()"></button>
    </div>

    <div class="row g-4">
        <!-- Columna Izquierda: Formulario de Selección -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-transparent border-0 pt-3 px-4 pb-0">
                    <h5 class="fw-bold mb-0">1. Datos del Cliente y Selección</h5>
                </div>
                <div class="card-body p-4">
                    <form id="formVenta" method="post" asp-page-handler="ProcesarVenta">
                        
                        <!-- Selección de Cliente -->
                        <div class="mb-4">
                            <label for="clienteId" class="form-label fw-semibold">Nombre del Cliente <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person-fill"></i></span>
                                <input type="number" id="clienteId" name="ClienteId" class="form-control" placeholder="ID o Folio de Cliente (Ej. 1)" required />
                            </div>
                            <small class="text-muted">Ingrese el ID del cliente registrado en el sistema.</small>
                        </div>

                        <!-- Selección de Producto en Stock -->
                        <div class="mb-4">
                            <label for="productoId" class="form-label fw-semibold">Producto a Vender (Gafas, Armazones sueltos, Accesorios) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-box-seam"></i></span>
                                <input type="number" id="productoId" name="ProductoId" class="form-control" placeholder="Código o ID de Producto (Ej. 1)" required />
                            </div>
                            <small class="text-muted">Solo se procesarán productos con existencia mayor a 0.</small>
                        </div>

                        <!-- Selección de Forma de Pago -->
                        <div class="mb-4">
                            <label for="formaPago" class="form-label fw-semibold">Forma de Pago <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-credit-card-fill"></i></span>
                                <select id="formaPago" name="FormaPago" class="form-select" required>
                                    <option value="Efectivo" selected>Efectivo</option>
                                    <option value="Tarjeta">Tarjeta de Débito/Crédito</option>
                                    <option value="Transferencia">Transferencia Electrónica</option>
                                </select>
                            </div>
                        </div>

                        <!-- Opción Cobro de Examen -->
                        <div class="card bg-light-subtle border p-3 mb-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="incluyeExamen" name="IncluyeExamen" value="true">
                                <label class="form-check-label fw-semibold" for="incluyeExamen">
                                    Incluir Examen de la Vista
                                </label>
                            </div>
                            <small class="text-muted mt-1 d-block">
                                Si el cliente realizó un examen en los últimos 30 días, la bonificación se calculará automáticamente.
                            </small>
                        </div>

                        <!-- Input Oculto enviado al servidor -->
                        <input type="hidden" id="totalVentaInput" name="TotalVenta" value="0.00" />
                    </form>
                </div>
            </div>
        </div>

        <!-- Columna Derecha: Resumen de Operación en Tiempo Real -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 sticky-top" style="top: 20px;">
                <div class="card-header bg-transparent border-0 pt-3 px-4 pb-0">
                    <h5 class="fw-bold mb-0">2. Resumen de la Operación</h5>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Subtotal Productos:</span>
                        <span id="subtotalProd" class="fw-semibold">$0.00 MXN</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Costo Examen de la Vista:</span>
                        <span id="subtotalExamen" class="fw-semibold">$0.00 MXN</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 text-success">
                        <span>Bonificación (Examen &le; 30 días):</span>
                        <span id="descuentoBonif" class="fw-semibold">-$0.00 MXN</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="h6 mb-0 fw-bold">Total a Cobrar:</span>
                        <span id="totalFinal" class="h4 mb-0 fw-bold text-primary">$0.00 MXN</span>
                    </div>

                    <button type="button" class="btn btn-success w-100 py-3 fw-bold fs-5 shadow-sm" onclick="abrirModalCobro()">
                        <i class="bi bi-cash-stack me-2"></i> Procesar Cobro en Caja
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Carga de la Vista Parcial de Modales -->
    <partial name="Modales/_ModalesVenta-CobroExamen" />
</div>

@section Scripts {
    <script>
        let precioProductoActual = 0.00;
        let costoExamenBase = 250.00;
        let descuentoExamen = 0.00;

        document.addEventListener("DOMContentLoaded", function () {
            const inputProducto = document.getElementById('productoId');
            const inputCliente = document.getElementById('clienteId');
            const chkExamen = document.getElementById('incluyeExamen');

            if (inputProducto) inputProducto.addEventListener('change', calcularTotales);
            if (inputCliente) inputCliente.addEventListener('change', calcularTotales);
            if (chkExamen) chkExamen.addEventListener('change', calcularTotales);
        });

        function calcularTotales() {
            const idProd = document.getElementById('productoId').value;
            const idCli = document.getElementById('clienteId').value || 0;
            const incluyeExamen = document.getElementById('incluyeExamen').checked;

            if (!idProd || idProd <= 0) {
                resetearResumen();
                return;
            }

            // Petición AJAX al handler C# OnGetConsultarProductoAsync
            fetch(`?handler=ConsultarProducto&idProducto=${idProd}&idCliente=${idCli}`)
                .then(res => res.json())
                .then(data => {
                    if (!data.success) {
                        mostrarAlerta(data.mensaje, "warning");
                        resetearResumen();
                        return;
                    }

                    cerrarAlerta();
                    precioProductoActual = data.precio;
                    costoExamenBase = data.precioExamen;

                    let subtotalExamen = incluyeExamen ? costoExamenBase : 0.00;
                    descuentoExamen = (incluyeExamen && data.aplicaBonificacion) ? costoExamenBase : 0.00;

                    let totalFinal = precioProductoActual + subtotalExamen - descuentoExamen;
                    if (totalFinal < 0) totalFinal = 0;

                    // Actualizar etiquetas en la interfaz
                    document.getElementById('subtotalProd').textContent = `$${precioProductoActual.toFixed(2)} MXN`;
                    document.getElementById('subtotalExamen').textContent = `$${subtotalExamen.toFixed(2)} MXN`;
                    document.getElementById('descuentoBonif').textContent = `-$${descuentoExamen.toFixed(2)} MXN`;
                    document.getElementById('totalFinal').textContent = `$${totalFinal.toFixed(2)} MXN`;

                    // Actualizar input oculto para enviar al backend al cobrar
                    document.getElementById('totalVentaInput').value = totalFinal.toFixed(2);
                })
                .catch(err => {
                    console.error("Error al consultar el producto:", err);
                });
        }

        function resetearResumen() {
            precioProductoActual = 0.00;
            document.getElementById('subtotalProd').textContent = "$0.00 MXN";
            document.getElementById('subtotalExamen').textContent = "$0.00 MXN";
            document.getElementById('descuentoBonif').textContent = "-$0.00 MXN";
            document.getElementById('totalFinal').textContent = "$0.00 MXN";
            document.getElementById('totalVentaInput').value = "0.00";
        }

        function abrirModalCobro() {
            var cliente = document.getElementById('clienteId').value;
            var producto = document.getElementById('productoId').value;

            if (!cliente || !producto) {
                mostrarAlerta("Por favor complete los campos obligatorios del cliente y producto.", "danger");
                return;
            }

            var modalEl = document.getElementById('modalConfirmarVenta');
            if (modalEl) {
                var modal = new bootstrap.Modal(modalEl);
                modal.show();
            } else {
                document.getElementById('formVenta').submit();
            }
        }

        function mostrarAlerta(mensaje, tipo) {
            var alerta = document.getElementById('alertaResultado');
            var texto = document.getElementById('alertaMensaje');
            alerta.className = "alert alert-" + tipo + " alert-dismissible fade show shadow-sm mb-4";
            texto.textContent = mensaje;
        }

        function cerrarAlerta() {
            var alerta = document.getElementById('alertaResultado');
            alerta.classList.add('d-none');
        }
    </script>
}