@page
@model Proyecto.Pages.GestionDeEmpleadosModel
@{
    ViewData["Title"] = "Gestión de Empleados";
}

<div class="container-fluid py-4">
    <!-- Alertas de Éxito y Error -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tabla Principal con Encabezado: Título a la izquierda, Controles alineados a la derecha -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-transparent border-0 py-3 d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h5 class="mb-1 fw-bold">Gestión de Empleados</h5>
                <p class="text-muted small mb-0">HU-01: Control de usuarios, roles y accesos</p>
            </div>
            
            <!-- Contenedor en una sola fila para Búsqueda, Filtros y Nuevo Empleado -->
            <div class="d-flex align-items-center gap-2">
                <!-- Formulario GET para Búsqueda + Filtros -->
                <form method="get" class="d-flex align-items-center gap-2 mb-0">
                    
                    <!-- 1. Barra de Búsqueda General -->
                    <div class="input-group input-group-sm shadow-sm border rounded-pill bg-white overflow-hidden" style="width: 280px;">
                        <span class="input-group-text bg-transparent border-0 ps-3 pe-1 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="search" 
                               asp-for="Buscar" 
                               class="form-control border-0 bg-transparent shadow-none px-1" 
                               placeholder="Buscar nombre, correo, lab..." />
                        @if (!string.IsNullOrWhiteSpace(Model.Buscar))
                        {
                            <a asp-page="/GestionDeEmpleados" 
                               class="btn btn-link text-muted pe-2 ps-1 text-decoration-none d-flex align-items-center" 
                               title="Limpiar búsqueda">
                                <i class="bi bi-x-circle-fill"></i>
                            </a>
                        }
                        <button type="submit" class="btn btn-primary px-3 rounded-pill my-1 me-1 font-weight-medium">
                            Buscar
                        </button>
                    </div>

                    <!-- 2. Menú Desplegable de Filtros con Flecha hacia abajo -->
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-2 d-flex align-items-center gap-1 shadow-sm" 
                                type="button" 
                                id="dropdownMenuFiltros" 
                                data-bs-toggle="dropdown" 
                                data-bs-auto-close="outside" 
                                aria-expanded="false">
                            <i class="bi bi-funnel-fill"></i> Filtros
                            @if (Model.FiltroRol.HasValue || Model.FiltroLaboratorio.HasValue || !string.IsNullOrEmpty(Model.FiltroEstado))
                            {
                                <span class="badge bg-primary rounded-pill me-1">●</span>
                            }
                            <i class="bi bi-chevron-down small text-muted ms-1"></i>
                        </button>
                        
                        <div class="dropdown-menu dropdown-menu-end p-3 shadow border-0" 
                             aria-labelledby="dropdownMenuFiltros" 
                             style="min-width: 280px;">
                            
                            <div class="mb-3">
                                <label class="form-label small fw-bold mb-1">Rol</label>
                                <select asp-for="FiltroRol" class="form-select form-select-sm">
                                    <option value="">-- Todos los Roles --</option>
                                    @if (Model.RolesList != null)
                                    {
                                        @foreach (var rol in Model.RolesList)
                                        {
                                            <option value="@rol.IdRol">@rol.NombreRol</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-bold mb-1">Laboratorio</label>
                                <select asp-for="FiltroLaboratorio" class="form-select form-select-sm">
                                    <option value="">-- Todos los Laboratorios --</option>
                                    @if (Model.LaboratoriosList != null)
                                    {
                                        @foreach (var lab in Model.LaboratoriosList)
                                        {
                                            <option value="@lab.IdLaboratorio">@lab.Nombre</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-bold mb-1">Estado</label>
                                <select asp-for="FiltroEstado" class="form-select form-select-sm">
                                    <option value="">-- Todos los Estados --</option>
                                    <option value="activo">Solo Activos</option>
                                    <option value="inactivo">Solo Inactivos</option>
                                </select>
                            </div>

                            <div class="d-flex gap-2 pt-2">
                                <button type="submit" class="btn btn-primary btn-sm flex-fill">
                                    Aplicar Filtros
                                </button>
                                <a asp-page="/GestionDeEmpleados" class="btn btn-outline-secondary btn-sm flex-fill text-center">
                                    Limpiar
                                </a>
                            </div>
                        </div>
                    </div>
                </form>

                <!-- 3. Botón Nuevo Empleado con Signo + -->
                <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 py-2 shadow-sm d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#modalCrearEmpleado">
                    <i class="bi bi-plus-lg me-1"></i> Nuevo Empleado
                </button>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive table-card">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="ps-3">ID</th>
                            <th scope="col">Nombre</th>
                            <th scope="col">Correo</th>
                            <th scope="col">Rol</th>
                            <th scope="col">Laboratorio</th>
                            <th scope="col">Estado</th>
                            <th scope="col" class="text-end pe-3">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.EmpleadosList != null && Model.EmpleadosList.Any())
                        {
                            @foreach (var emp in Model.EmpleadosList)
                            {
                                <tr>
                                    <td class="ps-3 text-muted fw-bold">#@emp.IdEmpleado</td>
                                    <td class="fw-medium">@emp.Nombre</td>
                                    <td>@emp.Usuario</td>
                                    <td>
                                        <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">
                                            @(emp.IdRolNavigation?.NombreRol ?? "Sin Rol")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border px-2 py-1">
                                            @(emp.IdLaboratorioNavigation?.Nombre ?? "N/A")
                                        </span>
                                    </td>
                                    <td>
                                        @if (emp.Activo)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        <button type="button" class="btn btn-sm btn-outline-secondary me-1" 
                                                data-bs-toggle="modal" 
                                                data-bs-target="#modalEditarEmpleado"
                                                data-id="@emp.IdEmpleado"
                                                data-nombre="@emp.Nombre"
                                                data-usuario="@emp.Usuario"
                                                data-rol="@emp.IdRol"
                                                data-laboratorio="@(emp.IdLaboratorio ?? 0)">
                                            Editar
                                        </button>

                                        <form method="post" asp-page-handler="ToggleEstado" class="d-inline">
                                            <input type="hidden" name="id" value="@emp.IdEmpleado" />
                                            @if (emp.Activo)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Desactivar</button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-success">Activar</button>
                                            }
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">No se encontraron empleados con los criterios ingresados.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<partial name="Modales/_ModalesEmpleado" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            
            // 1. Autogenerar contraseña temporal al escribir el Correo
            const inputUsuario = document.getElementById("usuarioEmpleado");
            const inputPass = document.getElementById("contrasenaTemporal");

            if (inputUsuario && inputPass) {
                inputUsuario.addEventListener("input", function () {
                    const usuarioVal = this.value.trim();
                    inputPass.value = usuarioVal.length > 0 ? "contrasena" + usuarioVal : "";
                });
            }

            // 2. Función para Ocultar/Mostrar el campo Laboratorio según el Rol
            function configurarToggleLaboratorio(selectRolId, divLabId, selectLabId) {
                const selectRol = document.getElementById(selectRolId);
                const divLab = document.getElementById(divLabId);
                const selectLab = document.getElementById(selectLabId);

                if (selectRol && divLab) {
                    const verificarRol = () => {
                        // Obtenemos el texto visible de la opción seleccionada
                        const textoRol = selectRol.options[selectRol.selectedIndex]?.text.toLowerCase() || "";
                        
                        // Si es laboratorista, mostramos el campo
                        if (textoRol.includes("laboratorista")) {
                            divLab.style.display = "block";
                        } else {
                            // Si no lo es, lo ocultamos y reiniciamos el valor a 0 (Ninguno)
                            divLab.style.display = "none";
                            if (selectLab) selectLab.value = "0";
                        }
                    };

                    selectRol.addEventListener("change", verificarRol);
                    verificarRol(); // Ejecutar al cargar para inicializar estado
                }
            }

            // Aplicar la regla a ambos modales
            configurarToggleLaboratorio("rolEmpleado", "divLaboratorio", "idLaboratorio");
            configurarToggleLaboratorio("editRol", "divEditLaboratorio", "editLaboratorio");

            // 3. Reabrir modal de Crear si hubo error en servidor
            @if (ViewData["ShowModal"]?.ToString() == "Crear")
            {
                <text>
                var modalCrear = new bootstrap.Modal(document.getElementById('modalCrearEmpleado'));
                modalCrear.show();
                </text>
            }
            // 4. Reabrir modal de Editar si hubo error en servidor
            else if (ViewData["ShowModal"]?.ToString() == "Editar")
            {
                <text>
                var modalEditar = new bootstrap.Modal(document.getElementById('modalEditarEmpleado'));
                modalEditar.show();
                </text>
            }

            // 5. Llenar el modal de edición al hacer clic en "Editar"
            var modalEditarElement = document.getElementById('modalEditarEmpleado');
            if (modalEditarElement) {
                modalEditarElement.addEventListener('show.bs.modal', function (event) {
                    var button = event.relatedTarget;
                    if (button) {
                        var id = button.getAttribute('data-id');
                        var nombre = button.getAttribute('data-nombre');
                        var usuario = button.getAttribute('data-usuario');
                        var rol = button.getAttribute('data-rol');
                        var laboratorio = button.getAttribute('data-laboratorio');

                        modalEditarElement.querySelector('#editId').value = id;
                        modalEditarElement.querySelector('#editNombre').value = nombre;
                        modalEditarElement.querySelector('#editUsuario').value = usuario;
                        modalEditarElement.querySelector('#editRol').value = rol;
                        modalEditarElement.querySelector('#editLaboratorio').value = laboratorio;

                        // Disparar el evento change para que se evalúe si debe mostrar el campo Laboratorio
                        modalEditarElement.querySelector('#editRol').dispatchEvent(new Event('change'));
                    }
                });
            }
        });
    </script>
}