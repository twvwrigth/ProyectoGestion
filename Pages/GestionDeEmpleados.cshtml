@page
@model Proyecto.Pages.GestionDeEmpleadosModel
@{
    ViewData["Title"] = "Gestión de Empleados";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-transparent border-0 py-3 d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-1 fw-bold">Gestión de Empleados</h5>
            <p class="text-muted small mb-0">HU-01: Control de usuarios, roles y accesos</p>
        </div>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalCrearEmpleado">
            + Nuevo Empleado
        </button>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive table-card">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col" class="ps-3">Nombre</th>
                        <th scope="col">Usuario</th>
                        <th scope="col">Rol</th>
                        <th scope="col">Estado</th>
                        <th scope="col" class="text-end pe-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.EmpleadosList != null && Model.EmpleadosList.Any())
                    {
                        @foreach (var emp in Model.EmpleadosList)
                        {
                            <tr>
                                <td class="ps-3 fw-medium">@emp.Nombre</td>
                                <td>@emp.Usuario</td>
                                <td>
                                    <!-- Muestra el nombre exacto del rol almacenado en la base de datos -->
                                    <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">
                                        @(emp.IdRolNavigation?.NombreRol ?? "Sin Rol")
                                    </span>
                                </td>
                                <td>
                                    @if (emp.Activo)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">Inactivo</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <button type="button" class="btn btn-sm btn-outline-secondary me-1" 
                                            data-bs-toggle="modal" 
                                            data-bs-target="#modalEditarEmpleado"
                                            data-id="@emp.IdEmpleado"
                                            data-nombre="@emp.Nombre"
                                            data-usuario="@emp.Usuario"
                                            data-rol="@emp.IdRol">
                                        Editar
                                    </button>

                                    <form method="post" asp-page-handler="ToggleEstado" class="d-inline">
                                        <input type="hidden" name="id" value="@emp.IdEmpleado" />
                                        @if (emp.Activo)
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Desactivar</button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-success">Activar</button>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No hay empleados registrados.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<partial name="Modales/_ModalesEmpleado" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            
            // 1. Auto-completado de contraseña temporal al escribir el usuario
            const inputUsuario = document.getElementById("usuarioEmpleado");
            const inputPass = document.getElementById("contrasenaTemporal");

            if (inputUsuario && inputPass) {
                inputUsuario.addEventListener("input", function () {
                    const usuarioVal = this.value.trim();
                    inputPass.value = usuarioVal.length > 0 ? "contrasena" + usuarioVal : "";
                });
            }

            // 2. Carga de datos al Modal de Edición desde el botón de la tabla
            const modalEditarEl = document.getElementById('modalEditarEmpleado');
            if (modalEditarEl) {
                modalEditarEl.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    
                    const id = button.getAttribute('data-id');
                    const nombre = button.getAttribute('data-nombre');
                    const usuario = button.getAttribute('data-usuario');
                    const rol = button.getAttribute('data-rol');

                    modalEditarEl.querySelector('#editId').value = id;
                    modalEditarEl.querySelector('#editNombre').value = nombre;
                    modalEditarEl.querySelector('#editUsuario').value = usuario;
                    
                    // Asigna el rol correspondiente
                    const editRolSelect = modalEditarEl.querySelector('#editRol');
                    if (editRolSelect) {
                        editRolSelect.value = rol;
                    }
                });
            }

            // 3. Limpieza de formularios y advertencias en rojo al cerrar cualquier modal
            const modales = document.querySelectorAll('.modal');
            modales.forEach(function (modal) {
                modal.addEventListener('hidden.bs.modal', function () {
                    const form = modal.querySelector('form');
                    if (form) {
                        form.reset(); 
                        
                        // Limpiar mensajes de error
                        const spansError = form.querySelectorAll('span.text-danger');
                        spansError.forEach(span => span.textContent = '');
                        
                        // Remover clases de borde rojo en inputs
                        const inputsError = form.querySelectorAll('.input-validation-error');
                        inputsError.forEach(input => input.classList.remove('input-validation-error'));
                    }
                });
            });
        });
    </script>

    <!-- 4. Reapertura de Modales en caso de error de validación -->
    @if (ViewData["ShowModal"]?.ToString() == "Crear")
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                var modal = new bootstrap.Modal(document.getElementById('modalCrearEmpleado'));
                modal.show();
            });
        </script>
    }
    else if (ViewData["ShowModal"]?.ToString() == "Editar")
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                var modal = new bootstrap.Modal(document.getElementById('modalEditarEmpleado'));
                modal.show();
            });
        </script>
    }

    <!-- 5. Apertura del Modal de Éxito al recibir mensaje en TempData -->
    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                var modalExitoEl = document.getElementById('modalExito');
                if (modalExitoEl) {
                    var modalExito = new bootstrap.Modal(modalExitoEl);
                    modalExito.show();
                }
            });
        </script>
    }
}